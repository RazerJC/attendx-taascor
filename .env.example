# TAASCOR Attendance Monitoring System - Environment Variables
# Copy this file to .env and fill in your values

# Server
PORT=3000
NODE_ENV=development

# MySQL / MariaDB database created in Hostinger hPanel
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=taascor
DB_USER=taascor_app
DB_PASSWORD=
DB_CONNECTION_LIMIT=5
DB_SSL=false
# Optional CA certificate file when the database requires TLS
# DB_SSL_CA=/path/to/ca.pem

# Session
SESSION_SECRET=change-this-to-a-random-64-char-string

# Initial Admin (only used on first run)
ADMIN_EMAIL=admin@taascor.com
ADMIN_PASSWORD=

# SMTP (for email verification and password recovery)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@taascor.com
SMTP_PASS=your-smtp-password-here
SMTP_FROM="TAASCOR System <noreply@taascor.com>"

# App URL (used in email links)
APP_URL=http://localhost:3000

# Timezone
TZ=Asia/Manila

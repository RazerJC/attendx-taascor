# TAASCOR Attendance Monitoring System - Environment Variables
# Copy this file to .env and fill in your values

# Server
PORT=3000
NODE_ENV=development

# Session
SESSION_SECRET=change-this-to-a-random-64-char-string

# Initial Admin (only used on first run)
ADMIN_EMAIL=admin@taascor.com
ADMIN_PASSWORD=ChangeMe123!

# SMTP (for email verification and password recovery)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@taascor.com
SMTP_PASS=your-smtp-password-here
SMTP_FROM="TAASCOR System <noreply@taascor.com>"

# App URL (used in email links)
APP_URL=http://localhost:3000

# Timezone
TZ=Asia/Manila

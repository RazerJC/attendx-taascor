<%- include('../partials/layout-top') %>

<div class="page-header">
    <div>
        <h2>Positions & Roles</h2>
        <div class="breadcrumb">
            <a href="/dashboard">Dashboard</a>
            <span>/</span>
            <span>Position Masterlist</span>
        </div>
    </div>
    <div>
        <button type="button" class="btn btn-primary" onclick="document.getElementById('addPosCard').style.display = document.getElementById('addPosCard').style.display === 'none' ? 'block' : 'none'">
            ➕ Add Position
        </button>
    </div>
</div>

<!-- Add Position Card -->
<div id="addPosCard" class="card mb-3" style="display: none; border: 2px solid var(--color-primary);">
    <div class="card-header" style="background: rgba(27,42,74,0.05);">
        <h3>Add New Position</h3>
    </div>
    <div class="card-body">
        <form action="/admin/positions" method="POST">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">

            <div class="form-row">
                <div class="form-group">
                    <label for="title">Position Title <span class="required">*</span></label>
                    <input type="text" id="title" name="title" class="form-control" placeholder="e.g. Forklift Operator" required>
                </div>
                <div class="form-group">
                    <label for="description">Position Description</label>
                    <input type="text" id="description" name="description" class="form-control" placeholder="e.g. Equipment operator, heavy handling">
                </div>
            </div>

            <div class="btn-group">
                <button type="submit" class="btn btn-primary">Save Position</button>
                <button type="button" class="btn btn-outline" onclick="document.getElementById('addPosCard').style.display = 'none'">Cancel</button>
            </div>
        </form>
    </div>
</div>

<!-- Positions Table -->
<div class="card">
    <div class="card-body" style="padding: 0;">
        <div class="table-responsive">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Position Title</th>
                        <th>Description</th>
                        <th>Active Employees</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    <% positions.forEach(p => { %>
                        <tr>
                            <td><strong><%= p.title %></strong></td>
                            <td><%= p.description || '—' %></td>
                            <td><span class="badge badge-primary"><%= p.active_workers %> Workers</span></td>
                            <td>
                                <span class="badge <%= p.is_active ? 'badge-success' : 'badge-secondary' %>">
                                    <%= p.is_active ? 'ACTIVE' : 'INACTIVE' %>
                                </span>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<%- include('../partials/layout-bottom') %>

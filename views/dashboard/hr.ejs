<%- include('../partials/layout-top') %>

<div class="page-header">
    <div>
        <h2>HR Management Dashboard</h2>
        <div class="breadcrumb">
            <span>Operational Date: <%= formatDate(today) %></span>
            <span>•</span>
            <span>System-Wide Attendance & Clearance Overview</span>
        </div>
    </div>
</div>

<!-- Summary Cards -->
<div class="summary-cards">
    <div class="summary-card">
        <div class="card-icon green">👥</div>
        <div class="card-data">
            <h4><%= systemAtt.presentCount %></h4>
            <p>Employees Present</p>
        </div>
    </div>

    <div class="summary-card">
        <div class="card-icon red">❌</div>
        <div class="card-data">
            <h4><%= systemAtt.absentCount %></h4>
            <p>Employees Absent</p>
        </div>
    </div>

    <div class="summary-card">
        <div class="card-icon yellow">🏥</div>
        <div class="card-data">
            <h4><%= pendingBtw.length %></h4>
            <p>Pending BTW Clearances</p>
        </div>
    </div>

    <div class="summary-card">
        <div class="card-icon blue">⏳</div>
        <div class="card-data">
            <h4><%= pendingCoordinators.length %></h4>
            <p>Pending Registrations</p>
        </div>
    </div>
</div>

<!-- Needs Your Action Section -->
<div class="card mb-3">
    <div class="card-header">
        <h3>⚡ Needs Your Action</h3>
        <span class="badge badge-primary"><%= pendingCoordinators.length + pendingBtw.length + activeConcerns.length + activeManpower.length %> Total</span>
    </div>
    <div class="card-body" style="padding: 0;">
        <ul class="action-list">
            <% pendingCoordinators.forEach(c => { %>
                <li class="action-list-item">
                    <div class="item-info">
                        <div class="item-title">Coordinator Registration: <%= c.full_name %> (<%= c.email %>)</div>
                        <div class="item-subtitle">Awaiting HR approval and warehouse area assignment</div>
                    </div>
                    <a href="/admin/pending-coordinators" class="btn btn-sm btn-warning">Review & Assign Area</a>
                </li>
            <% }) %>

            <% pendingBtw.forEach(b => { %>
                <li class="action-list-item">
                    <div class="item-info">
                        <div class="item-title">Back-to-Work Clearance: <%= b.full_name %> (<%= b.emp_code %>)</div>
                        <div class="item-subtitle">Area: <%= b.area_name %> • Case: <%= b.case_ref %> • Status: <%= b.status.replace(/_/g, ' ') %></div>
                    </div>
                    <a href="/btw/<%= b.id %>" class="btn btn-sm btn-primary">Review & Decide</a>
                </li>
            <% }) %>

            <% activeConcerns.forEach(c => { %>
                <li class="action-list-item">
                    <div class="item-info">
                        <div class="item-title">Employee Concern: <%= c.full_name %> — <%= c.category %></div>
                        <div class="item-subtitle">Area: <%= c.area_name %> • Coordinator: <%= c.coordinator_name || 'Assigned' %></div>
                    </div>
                    <a href="/concerns/<%= c.id %>" class="btn btn-sm btn-outline">Provide Instructions</a>
                </li>
            <% }) %>

            <% activeManpower.forEach(m => { %>
                <li class="action-list-item">
                    <div class="item-info">
                        <div class="item-title">Manpower Request: <%= m.area_name %> (Deployment: <%= formatDate(m.deployment_date) %>)</div>
                        <div class="item-subtitle">Needed: <%= m.total_requested %> workers • Proposed: <%= m.proposed_count %> • Confirmed: <%= m.confirmed_count %></div>
                    </div>
                    <a href="/manpower/<%= m.id %>" class="btn btn-sm btn-primary">Assign Workers</a>
                </li>
            <% }) %>

            <% if (pendingCoordinators.length === 0 && pendingBtw.length === 0 && activeConcerns.length === 0 && activeManpower.length === 0) { %>
                <li style="padding: 24px; text-align: center; color: var(--color-gray-500);">All action items are clear!</li>
            <% } %>
        </ul>
    </div>
</div>

<!-- Coordinator Daily Attendance Monitor -->
<div class="card">
    <div class="card-header">
        <h3>⏱️ Coordinator Attendance Today (<%= formatDate(today) %>)</h3>
        <a href="/coordinator-attendance" class="btn btn-sm btn-outline">View Attendance Logs</a>
    </div>
    <div class="card-body" style="padding: 0;">
        <div class="table-responsive">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Coordinator</th>
                        <th>Assigned Warehouse</th>
                        <th>Time-In</th>
                        <th>Time-Out</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (coordinatorAttendanceToday.length === 0) { %>
                        <tr>
                            <td colspan="5" class="text-center">No active coordinators found.</td>
                        </tr>
                    <% } else { %>
                        <% coordinatorAttendanceToday.forEach(c => { %>
                            <tr>
                                <td><strong><%= c.full_name %></strong></td>
                                <td><%= c.area_name || 'Unassigned' %></td>
                                <td>
                                    <% if (c.time_in) { %>
                                        <span style="color: var(--color-success); font-weight: 600;"><%= formatTime(c.time_in) %></span>
                                    <% } else { %>
                                        <span class="text-muted">Not recorded</span>
                                    <% } %>
                                </td>
                                <td>
                                    <% if (c.time_out) { %>
                                        <span style="color: var(--color-primary); font-weight: 600;"><%= formatTime(c.time_out) %></span>
                                    <% } else { %>
                                        <span class="text-muted">—</span>
                                    <% } %>
                                </td>
                                <td>
                                    <% if (c.correction_requested) { %>
                                        <span class="badge badge-warning">Correction Pending</span>
                                    <% } else if (c.time_out) { %>
                                        <span class="badge badge-success">Shift Completed</span>
                                    <% } else if (c.time_in) { %>
                                        <span class="badge badge-info">On Duty</span>
                                    <% } else { %>
                                        <span class="badge badge-secondary">Pending</span>
                                    <% } %>
                                </td>
                            </tr>
                        <% }) %>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<%- include('../partials/layout-bottom') %>

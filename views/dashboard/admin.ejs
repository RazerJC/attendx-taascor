<%- include('../partials/layout-top') %>

<div class="page-header">
    <div>
        <h2>System Administrator Dashboard</h2>
        <div class="breadcrumb">
            <span>Overall Workforce, Cross-Area Health & Audit Trail</span>
        </div>
    </div>
</div>

<!-- Summary Cards -->
<div class="summary-cards">
    <div class="summary-card">
        <div class="card-icon navy">👥</div>
        <div class="card-data">
            <h4><%= totalEmployees %></h4>
            <p>Active Employees</p>
        </div>
    </div>

    <div class="summary-card">
        <div class="card-icon blue">🏢</div>
        <div class="card-data">
            <h4><%= totalAreas %></h4>
            <p>Active Warehouses</p>
        </div>
    </div>

    <div class="summary-card">
        <div class="card-icon green">👤</div>
        <div class="card-data">
            <h4><%= totalUsers %></h4>
            <p>Active Accounts</p>
        </div>
    </div>

    <div class="summary-card">
        <div class="card-icon yellow">⏳</div>
        <div class="card-data">
            <h4><%= pendingAccounts %></h4>
            <p>Pending Registrations</p>
        </div>
    </div>
</div>

<!-- Cross-Area Operations Table -->
<div class="card mb-3">
    <div class="card-header">
        <h3>🏢 Area & Warehouse Operations Summary</h3>
        <a href="/admin/areas" class="btn btn-sm btn-outline">Manage Warehouses</a>
    </div>
    <div class="card-body" style="padding: 0;">
        <div class="table-responsive">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Warehouse / Area</th>
                        <th>Assigned Coordinator</th>
                        <th>Active Workforce</th>
                        <th>Present Today</th>
                        <th>Absent Today</th>
                    </tr>
                </thead>
                <tbody>
                    <% areaSummaries.forEach(a => { %>
                        <tr>
                            <td><strong><%= a.name %></strong></td>
                            <td><%= a.current_coordinator || '<span class="text-muted">Unassigned</span>' %></td>
                            <td><span class="badge badge-primary"><%= a.active_workers %> Workers</span></td>
                            <td><span style="color: var(--color-success); font-weight: 600;"><%= a.present_today %></span></td>
                            <td><span style="<%= a.absent_today > 0 ? 'color: var(--color-danger); font-weight: 700;' : 'color: var(--color-gray-400);' %>"><%= a.absent_today %></span></td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Recent System Audit Events -->
<div class="card">
    <div class="card-header">
        <h3>📜 Recent Audit Trail</h3>
        <a href="/admin/audit-logs" class="btn btn-sm btn-outline">View Full Audit Logs</a>
    </div>
    <div class="card-body" style="padding: 0;">
        <div class="table-responsive">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Timestamp</th>
                        <th>User</th>
                        <th>Role</th>
                        <th>Action</th>
                        <th>Entity</th>
                        <th>IP Address</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (recentAudit.length === 0) { %>
                        <tr><td colspan="6" class="text-center">No audit logs recorded yet.</td></tr>
                    <% } else { %>
                        <% recentAudit.forEach(log => { %>
                            <tr>
                                <td><%= formatDateTime(log.created_at) %></td>
                                <td><strong><%= log.full_name || 'System' %></strong></td>
                                <td><span class="badge badge-secondary"><%= log.role || 'SYS' %></span></td>
                                <td><code style="color: var(--color-primary);"><%= log.action %></code></td>
                                <td><%= log.entity_type || '—' %> #<%= log.entity_id || '—' %></td>
                                <td><span class="text-muted"><%= log.ip_address || '—' %></span></td>
                            </tr>
                        <% }) %>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<%- include('../partials/layout-bottom') %>

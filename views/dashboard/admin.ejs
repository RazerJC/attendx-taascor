<%- include('../partials/layout-top') %>

<%- include('../partials/dashboard-hero', {
    eyebrow: 'People and operations',
    headline: 'One connected team, across every workplace.',
    description: 'A shared view of HR and coordinator attendance, employee records, warehouse operations, and daily activity inside TAASCOR ETS.',
    contextTitle: 'System administrator workspace',
    contextText: 'Oversee your teams, manage account access, and follow operations across all assigned warehouses.'
}) %>

<!-- Summary Cards -->
<div class="summary-cards">
    <div class="summary-card">
        <div class="card-icon navy"><%- include('../partials/outline-icon', {icon:'people'}) %></div>
        <div class="card-data">
            <h4><%= staff.filter(s => s.status === "active").length %></h4>
            <p>Active HR & Coordinators</p>
        </div>
    </div>

    <div class="summary-card">
        <div class="card-icon blue"><%- include('../partials/outline-icon', {icon:'building'}) %></div>
        <div class="card-data">
            <h4><%= totalAreas %></h4>
            <p>Active Warehouses</p>
        </div>
    </div>

    <div class="summary-card">
        <div class="card-icon green"><%- include('../partials/outline-icon', {icon:'person'}) %></div>
        <div class="card-data">
            <h4><%= totalUsers %></h4>
            <p>Active Accounts</p>
        </div>
    </div>

    <div class="summary-card">
        <div class="card-icon yellow"><%- include('../partials/outline-icon', {icon:'hourglass'}) %></div>
        <div class="card-data">
            <h4><%= pendingAccounts %></h4>
            <p>Pending Registrations</p>
        </div>
    </div>
</div>

<%- include('../partials/dashboard-shortcuts', { shortcuts: [
    { href: '/coordinator-attendance', label: 'Staff attendance' },
    { href: '/admin/users', label: 'User management' },
    { href: '/admin/areas', label: 'Warehouses and areas' },
    { href: '/admin/audit-logs', label: 'Audit trail' }
] }) %>
<div class="card mb-3">
 <div class="card-header"><h3>My Team — HR & Coordinators</h3><a class="btn btn-sm btn-outline" href="/coordinator-attendance">Attendance history</a></div>
 <div class="card-body"><p>Today's shift · <%= formatDate(today) %> · Asia/Manila</p></div>
 <div class="table-responsive"><table class="data-table"><thead><tr><th>Staff member</th><th>Role / Account</th><th>Time in</th><th>Time out</th><th>Shift</th><th>Latest recorded activity</th></tr></thead><tbody>
 <% if (!staff.length) { %><tr><td colspan="6">No HR or coordinator accounts yet.</td></tr><% } %>
 <% staff.forEach(s => { %><tr><td><a href="/admin/staff/<%= s.id %>"><strong><%= s.full_name %></strong></a><br><small><%= s.email %></small></td><td><%= s.role %><br><small><%= s.status %></small></td><td><%= s.time_in ? formatTime(s.time_in) : '—' %></td><td><%= s.time_out ? formatTime(s.time_out) : '—' %></td><td><%= s.time_out ? 'Completed' : s.time_in ? 'On duty' : 'No time-in recorded' %></td><td><%= s.latest_action ? s.latest_action.replaceAll('_', ' ') : 'No recorded activity' %></td></tr><% }) %>
 </tbody></table></div>
</div>
<div class="card mb-3"><div class="card-header"><h3>Manpower Requests</h3><a href="/manpower" class="btn btn-sm btn-primary">Monitor requests</a></div><div class="card-body"><%= openRequestsCount %> open requests. Review HR allocations and coordinator arrival confirmations.</div></div>
<!-- Cross-Area Operations Table -->
<div class="card mb-3">
    <div class="card-header">
        <h3>🏢 Area & Warehouse Operations Summary</h3>
        <a href="/admin/areas" class="btn btn-sm btn-outline">Manage Warehouses</a>
    </div>
    <div class="card-body" style="padding: 0;">
        <div class="table-responsive">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Warehouse / Area</th>
                        <th>Assigned Coordinator</th>
                        <th>Active Workforce</th>
                        <th>Present Today</th>
                        <th>Absent Today</th>
                    </tr>
                </thead>
                <tbody>
                    <% areaSummaries.forEach(a => { %>
                        <tr>
                            <td><strong><%= a.name %></strong></td>
                            <td><%= a.current_coordinator || 'Unassigned' %></td>
                            <td><span class="badge badge-primary"><%= a.active_workers %> Workers</span></td>
                            <td><span style="color: var(--color-success); font-weight: 600;"><%= a.present_today %></span></td>
                            <td><span style="<%= a.absent_today > 0 ? 'color: var(--color-danger); font-weight: 700;' : 'color: var(--color-gray-400);' %>"><%= a.absent_today %></span></td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Recent System Audit Events -->
<div class="card">
    <div class="card-header">
        <h3>📜 Recent Audit Trail</h3>
        <a href="/admin/audit-logs" class="btn btn-sm btn-outline">View Full Audit Logs</a>
    </div>
    <div class="card-body" style="padding: 0;">
        <div class="table-responsive">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Timestamp</th>
                        <th>User</th>
                        <th>Role</th>
                        <th>Action</th>
                        <th>Entity</th>
                        <th>IP Address</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (recentAudit.length === 0) { %>
                        <tr><td colspan="6" class="text-center">No audit logs recorded yet.</td></tr>
                    <% } else { %>
                        <% recentAudit.forEach(log => { %>
                            <tr>
                                <td><%= formatDateTime(log.created_at) %></td>
                                <td><strong><%= log.full_name || 'System' %></strong></td>
                                <td><span class="badge badge-secondary"><%= log.role || 'SYS' %></span></td>
                                <td><code style="color: var(--color-primary);"><%= log.action %></code></td>
                                <td><%= log.entity_type || '—' %> #<%= log.entity_id || '—' %></td>
                                <td><span class="text-muted"><%= log.ip_address || '—' %></span></td>
                            </tr>
                        <% }) %>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<%- include('../partials/layout-bottom') %>

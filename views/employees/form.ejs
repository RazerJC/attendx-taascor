<%- include('../partials/layout-top') %>

<div class="page-header">
    <div>
        <h2><%= isEdit ? 'Edit Employee Record' : 'Add New Employee' %></h2>
        <div class="breadcrumb">
            <a href="/employees">Employees</a>
            <span>/</span>
            <span><%= isEdit ? employee.full_name : 'New Record' %></span>
        </div>
    </div>
</div>

<div style="max-width: 700px;">
    <div class="card">
        <div class="card-body">
            <form action="<%= isEdit ? '/employees/' + employee.id + '/edit' : '/employees' %>" method="POST">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                <div class="form-group">
                    <label for="employee_id">Employee ID <span class="required">*</span></label>
                    <input type="text" id="employee_id" name="employee_id" class="form-control"
                           value="<%= employee ? employee.employee_id : '' %>" placeholder="Enter employee ID" required <%= isEdit ? 'readonly' : '' %>>
                    <% if (!isEdit) { %><div class="form-help">The coordinator enters the employee's official ID. It must be unique.</div><% } %>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label for="first_name">First Name <span class="required">*</span></label>
                        <input type="text" id="first_name" name="first_name" class="form-control" 
                               value="<%= employee ? employee.first_name : '' %>" required autofocus>
                    </div>

                    <div class="form-group">
                        <label for="last_name">Last Name <span class="required">*</span></label>
                        <input type="text" id="last_name" name="last_name" class="form-control" 
                               value="<%= employee ? employee.last_name : '' %>" required>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label for="area_id">Warehouse / Area <span class="required">*</span></label>
                        <% if (user.role === 'COORDINATOR') { %>
                            <input type="hidden" name="area_id" value="<%= userAreaId %>">
                            <input type="text" class="form-control" value="<%= userArea ? userArea.name : '' %>" readonly disabled>
                            <div class="form-help">Locked to your authorized assignment.</div>
                        <% } else { %>
                            <select id="area_id" name="area_id" class="form-control" required>
                                <option value="">Select Warehouse</option>
                                <% areas.forEach(a => { %>
                                    <option value="<%= a.id %>" <%= (employee && employee.area_id === a.id) ? 'selected' : '' %>><%= a.name %></option>
                                <% }) %>
                            </select>
                        <% } %>
                    </div>

                    <div class="form-group">
                        <label for="position_title">Designated Position</label>
                        <input type="text" id="position_title" name="position_title" class="form-control" list="position-options"
                               value="<%= employee && employee.position_title ? employee.position_title : '' %>" placeholder="Enter or select position">
                        <datalist id="position-options">
                            <% positions.forEach(p => { %>
                                <option value="<%= p.title %>"></option>
                            <% }) %>
                        </datalist>
                        <div class="form-help">Type a new position if it is not listed.</div>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label for="department_id">Department / Operational Team</label>
                        <select id="department_id" name="department_id" class="form-control">
                            <option value="">-- Select Department --</option>
                            <% (departments || []).forEach(d => { %>
                                <option value="<%= d.id %>" <%= (employee && employee.department_id === d.id) ? 'selected' : '' %>><%= d.name %></option>
                            <% }) %>
                        </select>
                        <div class="form-help">Client department or line (e.g. PH LAG1, BC MAMATID).</div>
                    </div>

                    <div class="form-group">
                        <label for="employment_start_date">Employment Start Date <span class="required">*</span></label>
                        <input type="date" id="employment_start_date" name="employment_start_date" class="form-control" 
                               value="<%= employee ? employee.employment_start_date : new Date().toISOString().split('T')[0] %>" required>
                    </div>
                </div>

                <div class="form-group">
                    <label for="remarks">Remarks / Operational Notes</label>
                    <textarea id="remarks" name="remarks" class="form-control" rows="3" placeholder="Optional notes regarding assignment, certifications, etc."><%= employee ? employee.remarks : '' %></textarea>
                </div>

                <div class="d-flex gap-1" style="margin-top: 24px;">
                    <button type="submit" class="btn btn-primary btn-lg">
                        <%= isEdit ? 'Save Changes' : 'Create Employee Record' %>
                    </button>
                    <a href="<%= isEdit ? '/employees/' + employee.id : '/employees' %>" class="btn btn-outline btn-lg">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

<%- include('../partials/layout-bottom') %>

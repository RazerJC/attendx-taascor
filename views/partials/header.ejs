<header class="header">
    <div class="header-left">
        <button type="button" class="mobile-menu-btn" id="mobileMenuBtn" aria-label="Toggle menu" aria-expanded="false" aria-controls="sidebar">☰</button>
        <span class="header-role"><%= user ? ({ ADMIN: 'Admin', HR: 'HR', HEAD_HR: 'Head HR', COORDINATOR: 'Coordinator' }[user.role] || user.role) : 'Workspace' %></span>
        <span class="header-separator" aria-hidden="true">/</span>
        <h1><%= title ? title.replace(' - TAASCOR', '') : 'TAASCOR Attendance Monitoring' %></h1>
    </div>

    <div class="header-right">
        <span class="workspace-pill"><%= user ? ({ ADMIN: 'Admin workspace', HR: 'HR workspace', HEAD_HR: 'Head HR workspace', COORDINATOR: 'Coordinator workspace' }[user.role] || user.role) : 'Workspace' %></span>
        <% if (user && user.role === 'COORDINATOR') { %>
            <a href="/coordinator-attendance" class="btn btn-time btn-sm <%= typeof needsCoordinatorTimeIn !== 'undefined' && needsCoordinatorTimeIn ? 'time-in-needed' : '' %>">
                <% if (typeof needsCoordinatorTimeIn !== 'undefined' && needsCoordinatorTimeIn) { %>
                    <span aria-hidden="true">!</span> Not timed in · Time in now
                <% } else { %>
                    <span>⏱️</span> Time In / Out
                <% } %>
            </a>
        <% } %>

        <!-- Notification Bell with Dropdown -->
        <div class="dropdown" id="notifDropdownWrap">
            <button type="button" class="notif-bell" id="notifBellBtn" aria-label="Notifications" aria-expanded="false" aria-controls="notifMenu">
                <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9"/><path d="M10 21h4"/></svg>
                <span class="notif-badge <%= (typeof unreadCount !== 'undefined' && unreadCount > 0) ? '' : 'hidden' %>" id="notifCountBadge">
                    <%= unreadCount || 0 %>
                </span>
            </button>
            <div class="dropdown-menu notif-dropdown" id="notifMenu">
                <div class="notif-header">
                    <span>Notifications</span>
                    <a href="/notifications" style="color: var(--color-primary); text-decoration: underline;">View All</a>
                </div>
                <div id="notifItemsContainer">
                    <div class="loading"><div class="spinner"></div> Loading...</div>
                </div>
            </div>
        </div>

        <!-- User Profile Dropdown -->
        <div class="dropdown" id="userDropdownWrap">
            <button type="button" class="user-menu" id="userMenuBtn" aria-label="Account menu" aria-expanded="false" aria-controls="userMenu">
                <span class="user-avatar" style="overflow: hidden; display: flex; align-items: center; justify-content: center; padding: 0;">
                    <% if (user && user.profile_photo) { %>
                        <img src="<%= user.profile_photo %>" alt="<%= user.full_name %>" style="width: 100%; height: 100%; object-fit: cover; border-radius: 50%;">
                    <% } else { %>
                        <%= user ? user.full_name.charAt(0).toUpperCase() : 'U' %>
                    <% } %>
                </span>
                <span class="user-info">
                    <span class="user-name"><%= user ? user.full_name : 'Guest' %></span>
                    <span class="user-role">
                        <%= user ? user.role : '' %>
                        <% if (typeof userArea !== 'undefined' && userArea) { %>
                            • <%= userArea.name %>
                        <% } %>
                    </span>
                </span>
            </button>
            <div class="dropdown-menu" id="userMenu">
                <div style="padding: 10px 16px; border-bottom: 1px solid var(--color-gray-100); font-size: 0.8rem; color: var(--color-gray-500);">
                    Signed in as <strong style="color: var(--color-gray-800);"><%= user ? user.email : '' %></strong>
                </div>
                <a href="/profile" class="dropdown-item">
                    <span>👤</span> My Profile
                </a>
                <a href="/change-password" class="dropdown-item">
                    <span>🔑</span> Change Password
                </a>
                <div class="dropdown-divider"></div>
                <a href="/logout" class="dropdown-item" style="color: var(--color-danger);">
                    <span>🚪</span> Sign Out
                </a>
            </div>
        </div>
        <a href="/logout" class="header-logout">Log out</a>
    </div>
</header>

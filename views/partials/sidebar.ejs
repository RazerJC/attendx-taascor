<aside class="sidebar" id="sidebar">
    <div class="sidebar-logo">
        <div class="sidebar-logo-container">
            <img src="/images/taascor-logo.png" alt="TAASCOR Management & General Services Corp.">
        </div>
        <div class="logo-subtext">Attendance Monitoring System</div>
    </div>

    <nav class="sidebar-nav">
        <div class="nav-section">
            <a href="/dashboard" class="nav-item <%= currentPath === '/dashboard' ? 'active' : '' %>">
                <span class="nav-icon">📊</span>
                <span>Dashboard</span>
            </a>
            
            <a href="/employees" class="nav-item <%= currentPath.startsWith('/employees') ? 'active' : '' %>">
                <span class="nav-icon">👥</span>
                <span>Employees</span>
            </a>

            <a href="/departments" class="nav-item <%= currentPath.startsWith('/departments') ? 'active' : '' %>">
                <span class="nav-icon">🏢</span>
                <span>Departments</span>
            </a>

            <a href="/attendance" class="nav-item <%= currentPath === '/attendance' ? 'active' : '' %>">
                <span class="nav-icon">📋</span>
                <span>Attendance</span>
            </a>

            <a href="/schedules" class="nav-item <%= currentPath.startsWith('/schedules') ? 'active' : '' %>">
                <span class="nav-icon">📅</span>
                <span>Schedules</span>
            </a>
        </div>

        <div class="nav-section-label">Operations</div>
        <div class="nav-section">
            <% if (user && user.role === 'COORDINATOR') { %>
                <a href="/coordinator-attendance" class="nav-item <%= currentPath.startsWith('/coordinator-attendance') ? 'active' : '' %>">
                    <span class="nav-icon">⏱️</span>
                    <span>My Attendance</span>
                </a>
            <% } else { %>
                <a href="/coordinator-attendance" class="nav-item <%= currentPath.startsWith('/coordinator-attendance') ? 'active' : '' %>">
                    <span class="nav-icon">⏱️</span>
                    <span>Coordinator Attendance</span>
                </a>
            <% } %>

            <a href="/btw" class="nav-item <%= currentPath.startsWith('/btw') ? 'active' : '' %>">
                <span class="nav-icon">🏥</span>
                <span>Back-to-Work</span>
            </a>

            <a href="/concerns" class="nav-item <%= currentPath.startsWith('/concerns') ? 'active' : '' %>">
                <span class="nav-icon">💬</span>
                <span>Employee Concerns</span>
            </a>

            <a href="/manpower" class="nav-item <%= currentPath.startsWith('/manpower') ? 'active' : '' %>">
                <span class="nav-icon">🤝</span>
                <span>Manpower Requests</span>
            </a>
        </div>

        <div class="nav-section-label">Intelligence & Admin</div>
        <div class="nav-section">
            <a href="/reports" class="nav-item <%= currentPath.startsWith('/reports') ? 'active' : '' %>">
                <span class="nav-icon">📈</span>
                <span>Reports & Exports</span>
            </a>

            <% if (user && (user.role === 'HR' || user.role === 'ADMIN')) { %>
                <a href="/admin/pending-coordinators" class="nav-item <%= currentPath.startsWith('/admin/pending-coordinators') ? 'active' : '' %>">
                    <span class="nav-icon">⏳</span>
                    <span>Pending Approvals</span>
                </a>
                <a href="/admin/areas" class="nav-item <%= currentPath.startsWith('/admin/areas') ? 'active' : '' %>">
                    <span class="nav-icon">🏢</span>
                    <span>Warehouses / Areas</span>
                </a>
                <a href="/admin/positions" class="nav-item <%= currentPath.startsWith('/admin/positions') ? 'active' : '' %>">
                    <span class="nav-icon">🏷️</span>
                    <span>Positions</span>
                </a>
            <% } %>

            <% if (user && user.role === 'ADMIN') { %>
                <a href="/admin/users" class="nav-item <%= currentPath.startsWith('/admin/users') ? 'active' : '' %>">
                    <span class="nav-icon">⚙️</span>
                    <span>User Management</span>
                </a>
                <a href="/admin/audit-logs" class="nav-item <%= currentPath.startsWith('/admin/audit-logs') ? 'active' : '' %>">
                    <span class="nav-icon">📜</span>
                    <span>Audit Logs</span>
                </a>
            <% } %>
        </div>

        <div class="nav-section-label">Account</div>
        <div class="nav-section">
            <a href="/profile" class="nav-item <%= currentPath === '/profile' ? 'active' : '' %>">
                <span class="nav-icon">👤</span>
                <span>My Profile</span>
            </a>
        </div>
    </nav>

    <div class="sidebar-footer">
        <div>TAASCOR Management & General Services Corp.</div>
        <div style="font-size: 0.7rem; color: rgba(255,255,255,0.4); margin-top: 4px;">v1.0 • Asia/Manila</div>
    </div>
</aside>
<div class="sidebar-overlay" id="sidebarOverlay"></div>

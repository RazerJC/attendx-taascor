<%- include('../partials/layout-top') %>

<div class="page-header">
    <div>
        <h2>Requests & Concerns Hub</h2>
        <div class="breadcrumb">
            <span>Employee Concern Reports & HR Directives</span>
        </div>
    </div>
    <div>
        <a href="/concerns/new" class="btn btn-primary">💬 Report Employee Concern</a>
    </div>
</div>

<!-- Three Hub Tabs -->
<div class="tabs">
    <a href="/btw" class="tab">
        🏥 Back-to-Work Clearances
    </a>
    <a href="/concerns" class="tab active">
        💬 Employee Concerns
        <span class="tab-count"><%= concerns.length %></span>
    </a>
    <a href="/manpower" class="tab">
        🤝 Manpower Requests
    </a>
</div>

<!-- Filter Bar -->
<form method="GET" action="/concerns" class="filter-bar">
    <div class="filter-group">
        <label for="status">Status</label>
        <select id="status" name="status" class="form-control" onchange="this.form.submit()">
            <option value="">All Statuses</option>
            <option value="submitted" <%= statusFilter === 'submitted' ? 'selected' : '' %>>Submitted</option>
            <option value="under_review" <%= statusFilter === 'under_review' ? 'selected' : '' %>>Under Review</option>
            <option value="for_employee_reporting" <%= statusFilter === 'for_employee_reporting' ? 'selected' : '' %>>For Employee Reporting</option>
            <option value="resolved" <%= statusFilter === 'resolved' ? 'selected' : '' %>>Resolved</option>
        </select>
    </div>

    <% if (areas.length > 0) { %>
        <div class="filter-group">
            <label for="area_id">Warehouse</label>
            <select id="area_id" name="area_id" class="form-control" onchange="this.form.submit()">
                <option value="">All Warehouses</option>
                <% areas.forEach(a => { %>
                    <option value="<%= a.id %>" <%= selectedAreaId === a.id ? 'selected' : '' %>><%= a.name %></option>
                <% }) %>
            </select>
        </div>
    <% } %>

    <div style="display: flex; gap: 8px;">
        <button type="submit" class="btn btn-outline">Filter</button>
        <% if (statusFilter || (areas.length > 0 && selectedAreaId)) { %>
            <a href="/concerns" class="btn btn-ghost">Reset</a>
        <% } %>
    </div>
</form>

<!-- Thread List -->
<div class="card">
    <div class="card-body" style="padding: 0;">
        <div class="table-responsive">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Employee</th>
                        <th>Warehouse</th>
                        <th>Category</th>
                        <th>Reported By</th>
                        <th>Status</th>
                        <th>Replies</th>
                        <th>Date Reported</th>
                        <th class="text-right">Action</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (concerns.length === 0) { %>
                        <tr>
                            <td colspan="8">
                                <div class="empty-state">
                                    <div class="empty-icon">💬</div>
                                    <h3>No concern reports found</h3>
                                    <p>Coordinators can report concerns regarding employee tardiness, disputes, or medical issues.</p>
                                </div>
                            </td>
                        </tr>
                    <% } else { %>
                        <% concerns.forEach(c => { %>
                            <tr>
                                <td>
                                    <strong><%= c.employee_name %></strong><br>
                                    <span class="text-muted text-xs"><%= c.emp_code %></span>
                                </td>
                                <td><%= c.area_name %></td>
                                <td><span class="badge badge-secondary"><%= c.category %></span></td>
                                <td><%= c.reported_by_name || 'Coordinator' %></td>
                                <td><%- include('../partials/status-badge', { status: c.status }) %></td>
                                <td><%= c.reply_count %> updates</td>
                                <td><%= formatDate(c.created_at) %></td>
                                <td class="text-right">
                                    <a href="/concerns/<%= c.id %>" class="btn btn-sm btn-primary">View Thread</a>
                                </td>
                            </tr>
                        <% }) %>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<%- include('../partials/layout-bottom') %>

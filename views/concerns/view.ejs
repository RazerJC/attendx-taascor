<%- include('../partials/layout-top') %>

<div class="page-header">
    <div>
        <h2>Employee Concern: <%= concern.employee_name %></h2>
        <div class="breadcrumb">
            <a href="/concerns">Requests & Concerns</a>
            <span>/</span>
            <span>Employee Concerns</span>
            <span>/</span>
            <span>Case #<%= concern.id %></span>
        </div>
    </div>
    <div>
        <%- include('../partials/status-badge', { status: concern.status }) %>
    </div>
</div>

<!-- Concern Overview Card -->
<div class="detail-grid card mb-3" style="padding: 20px;">
    <div class="detail-item">
        <div class="detail-label">Subject Employee</div>
        <div class="detail-value">
            <a href="/employees/<%= concern.employee_id %>"><%= concern.employee_name %> (<%= concern.emp_code %>)</a>
        </div>
    </div>
    <div class="detail-item">
        <div class="detail-label">Warehouse / Area</div>
        <div class="detail-value"><%= concern.area_name %></div>
    </div>
    <div class="detail-item">
        <div class="detail-label">Concern Category</div>
        <div class="detail-value"><strong style="color: var(--color-primary);"><%= concern.category %></strong></div>
    </div>
    <div class="detail-item">
        <div class="detail-label">Reporting Coordinator</div>
        <div class="detail-value"><%= concern.reported_by_name || 'Coordinator' %></div>
    </div>
    <div class="detail-item">
        <div class="detail-label">Date Reported</div>
        <div class="detail-value"><%= formatDateTime(concern.created_at) %></div>
    </div>
</div>

<!-- Thread & Follow-ups -->
<div class="card mb-3">
    <div class="card-header">
        <h3>💬 Thread & HR Instructions (<%= entries.length %>)</h3>
    </div>
    <div class="card-body">
        <div class="thread">
            <% entries.forEach(entry => { %>
                <div class="thread-entry">
                    <div class="thread-avatar <%= entry.author_role.toLowerCase() %>">
                        <%= entry.author_name ? entry.author_name.charAt(0).toUpperCase() : 'S' %>
                    </div>
                    <div class="thread-content">
                        <div class="thread-meta">
                            <span class="thread-author"><%= entry.author_name || 'System' %></span>
                            <span class="thread-role <%= entry.author_role.toLowerCase() %>"><%= entry.author_role %></span>
                            <span class="thread-time">• <%= formatDateTime(entry.created_at) %></span>
                        </div>
                        <div class="thread-body <%= entry.entry_type === 'instruction' ? 'thread-status-change' : '' %>" style="<%= entry.entry_type === 'instruction' ? 'border-left-color: var(--color-accent); font-style: normal;' : '' %>">
                            <% if (entry.entry_type === 'instruction') { %>
                                <strong style="color: var(--color-accent); display: block; margin-bottom: 4px;">HR Instruction / Directive:</strong>
                            <% } %>
                            <%= entry.content %>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>

        <!-- Add Reply Form -->
        <div style="border-top: 2px solid var(--color-gray-200); padding-top: 20px; margin-top: 20px;">
            <h4 style="font-size: 0.95rem; margin-bottom: 12px; color: var(--color-primary);">Add Update or Directive</h4>
            <form action="/concerns/<%= concern.id %>/reply" method="POST">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                <div class="form-group">
                    <textarea name="content" class="form-control" rows="3" placeholder="<%= user.role === 'COORDINATOR' ? 'Post coordinator follow-up, meeting notes, or employee updates...' : 'Provide specific HR instructions or guidance...' %>" required></textarea>
                </div>

                <% if (user.role === 'HR' || user.role === 'ADMIN') { %>
                    <div class="form-group">
                        <label for="new_status">Update Status (Optional)</label>
                        <select name="new_status" id="new_status" class="form-control" style="max-width: 300px;">
                            <option value="">Keep current status (<%= concern.status.replace(/_/g, ' ') %>)</option>
                            <option value="under_review">Mark as: Under Review</option>
                            <option value="for_employee_reporting">Mark as: For Employee Reporting</option>
                            <option value="resolved">Mark as: Resolved</option>
                        </select>
                    </div>
                <% } %>

                <button type="submit" class="btn btn-primary">
                    Post Message
                </button>
            </form>
        </div>
    </div>
</div>

<%- include('../partials/layout-bottom') %>

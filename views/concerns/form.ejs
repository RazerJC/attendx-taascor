<%- include('../partials/layout-top') %>

<div class="page-header">
    <div>
        <h2>Report Employee Concern</h2>
        <div class="breadcrumb">
            <a href="/concerns">Employee Concerns</a>
            <span>/</span>
            <span>New Report</span>
        </div>
    </div>
</div>

<div style="max-width: 700px;">
    <div class="card">
        <div class="card-body">
            <form action="/concerns" method="POST">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                <div class="form-group">
                    <label for="employee_id">Subject Employee <span class="required">*</span></label>
                    <select id="employee_id" name="employee_id" class="form-control" required autofocus>
                        <option value="">— Select Employee —</option>
                        <% employees.forEach(e => { %>
                            <option value="<%= e.id %>" <%= preselectedEmpId === e.id ? 'selected' : '' %>>
                                <%= e.full_name %> (<%= e.employee_id %>)
                            </option>
                        <% }) %>
                    </select>
                </div>

                <div class="form-group">
                    <label for="category">Concern Category <span class="required">*</span></label>
                    <select id="category" name="category" class="form-control" required>
                        <option value="">— Select Category —</option>
                        <option value="Tardiness / Habitual Late">Tardiness / Habitual Late</option>
                        <option value="Unexcused Absences">Unexcused Absences</option>
                        <option value="Workplace Dispute / Conduct">Workplace Dispute / Conduct</option>
                        <option value="Health / Medical Concern">Health / Medical Concern</option>
                        <option value="Performance / Quality Issue">Performance / Quality Issue</option>
                        <option value="Policy Violation">Policy Violation</option>
                        <option value="Other">Other Operational Concern</option>
                    </select>
                </div>

                <div class="form-group">
                    <label for="description">Detailed Description & Circumstances <span class="required">*</span></label>
                    <textarea id="description" name="description" class="form-control" rows="5" placeholder="Detail the incident, dates, attempts to address the concern, and specific assistance needed from HR..." required></textarea>
                </div>

                <div class="d-flex gap-1" style="margin-top: 24px;">
                    <button type="submit" class="btn btn-primary btn-lg">Submit Concern to HR</button>
                    <a href="/concerns" class="btn btn-outline btn-lg">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

<%- include('../partials/layout-bottom') %>

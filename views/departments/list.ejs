<%- include('../partials/layout-top') %>

<div class="page-header">
    <div>
        <h2>Operational Departments</h2>
        <div class="breadcrumb">
            <span>Manage departments and assign employees to operational lines</span>
            <% if (typeof userArea !== 'undefined' && userArea) { %>
                <span>•</span>
                <span><%= userArea.name %></span>
            <% } %>
        </div>
    </div>
    <div style="display: flex; gap: 8px;">
        <button type="button" class="btn btn-primary" onclick="openAddDeptModal()">➕ Add Department</button>
    </div>
</div>

<!-- Filter Bar -->
<form method="GET" action="/departments" class="filter-bar">
    <div class="filter-group" style="flex: 1; min-width: 200px;">
        <label for="search">Search</label>
        <div class="search-box">
            <span class="search-icon">🔍</span>
            <input type="text" id="search" name="search" class="form-control" placeholder="Search department name..." value="<%= search %>">
        </div>
    </div>

    <% if (areas.length > 0) { %>
        <div class="filter-group">
            <label for="area_id">Warehouse / Area</label>
            <select id="area_id" name="area_id" class="form-control" onchange="this.form.submit()">
                <option value="">All Warehouses</option>
                <% areas.forEach(a => { %>
                    <option value="<%= a.id %>" <%= selectedAreaId === a.id ? 'selected' : '' %>><%= a.name %></option>
                <% }) %>
            </select>
        </div>
    <% } %>

    <div style="display: flex; gap: 8px;">
        <button type="submit" class="btn btn-outline">Filter</button>
        <% if (search || (areas.length > 0 && selectedAreaId)) { %>
            <a href="/departments" class="btn btn-ghost">Reset</a>
        <% } %>
    </div>
</form>

<!-- Unassigned Employees Alert if any -->
<% if (unassignedEmployees && unassignedEmployees.length > 0) { %>
    <div class="alert alert-warning mb-3" style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px;">
        <div style="display: flex; align-items: center; gap: 10px;">
            <span style="font-size: 1.4rem;">⚠️</span>
            <div>
                <strong><%= unassignedEmployees.length %> Active Employee(s) currently unassigned to any department</strong>
                <div class="text-xs" style="color: #92400e; margin-top: 2px;">Assign them to a department so they appear under the correct team in attendance sheets.</div>
            </div>
        </div>
        <button type="button" class="btn btn-sm btn-outline" style="background: white; border-color: #f59e0b; color: #b45309;" onclick="document.getElementById('unassignedSection').scrollIntoView({ behavior: 'smooth' })">
            View Unassigned (↓)
        </button>
    </div>
<% } %>

<!-- Departments Grid -->
<div class="departments-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(360px, 1fr)); gap: 18px; margin-bottom: 28px;">
    <% if (departments.length === 0) { %>
        <div class="card" style="grid-column: 1 / -1; padding: 48px; text-align: center;">
            <div style="font-size: 3rem; margin-bottom: 12px;">🏢</div>
            <h3>No Departments Found</h3>
            <p class="text-muted mb-3">Create your first operational department (e.g. PH LAG1, BC MAMATID, Logistics) to organize employee attendance.</p>
            <button type="button" class="btn btn-primary" onclick="openAddDeptModal()">➕ Create Department</button>
        </div>
    <% } else { %>
        <% departments.forEach(dept => { 
            const emps = deptEmployeesMap[dept.id] || [];
        %>
            <div class="card" style="display: flex; flex-direction: column; justify-content: space-between; border-top: 3px solid var(--color-primary);">
                <div class="card-body">
                    <div style="display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; margin-bottom: 12px;">
                        <div>
                            <h3 style="margin: 0; font-size: 1.15rem; color: var(--color-gray-900);">
                                🏢 <%= dept.name %>
                            </h3>
                            <span class="text-muted text-xs" style="display: block; margin-top: 3px;">
                                📍 <%= dept.area_name %>
                            </span>
                        </div>
                        <span class="badge" style="background: rgba(37, 99, 235, 0.1); color: var(--color-primary); font-size: 0.8rem; font-weight: 700; padding: 4px 10px; border-radius: 9999px;">
                            👥 <%= dept.employee_count %> Staff
                        </span>
                    </div>

                    <% if (dept.description) { %>
                        <p class="text-muted text-xs" style="margin-bottom: 12px;"><%= dept.description %></p>
                    <% } %>

                    <!-- Employee Preview / List -->
                    <div style="margin-top: 14px; border-top: 1px solid var(--color-gray-200); padding-top: 10px;">
                        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px;">
                            <span class="text-xs font-semibold uppercase text-muted" style="letter-spacing: 0.05em;">Assigned Staff (<%= emps.length %>)</span>
                            <button type="button" class="btn btn-ghost btn-xs" onclick="toggleDeptStaff('deptStaff_<%= dept.id %>')">
                                Toggle List
                            </button>
                        </div>
                        <div id="deptStaff_<%= dept.id %>" style="max-height: 160px; overflow-y: auto; display: none;">
                            <% if (emps.length === 0) { %>
                                <p class="text-muted text-xs" style="padding: 6px 0;">No staff assigned to this department yet.</p>
                            <% } else { %>
                                <ul style="list-style: none; padding: 0; margin: 0;">
                                    <% emps.forEach(e => { %>
                                        <li style="display: flex; align-items: center; justify-content: space-between; padding: 4px 0; border-bottom: 1px solid rgba(0,0,0,0.04); font-size: 0.82rem;">
                                            <div>
                                                <strong><%= e.last_name %>, <%= e.first_name %></strong>
                                                <span class="text-muted text-xs" style="margin-left: 4px;">• <%= e.position_title || 'Staff' %></span>
                                            </div>
                                            <button type="button" class="btn btn-ghost btn-xs" style="color: var(--color-primary); padding: 2px 6px;" onclick="openReassignModal(<%= e.id %>, '<%= e.full_name.replace(/'/g, "\\'") %>', <%= dept.id %>)">
                                                Move
                                            </button>
                                        </li>
                                    <% }) %>
                                </ul>
                            <% } %>
                        </div>
                    </div>
                </div>

                <!-- Footer Actions -->
                <div class="card-footer" style="background: rgba(0,0,0,0.015); border-top: 1px solid var(--color-gray-200); padding: 10px 16px; display: flex; justify-content: space-between; align-items: center;">
                    <button type="button" class="btn btn-ghost btn-sm" onclick="openEditDeptModal(<%= dept.id %>, '<%= dept.name.replace(/'/g, "\\'") %>', '<%= (dept.description || '').replace(/'/g, "\\'") %>')">
                        ✏️ Rename
                    </button>
                    <% if (dept.employee_count === 0) { %>
                        <form action="/departments/<%= dept.id %>/delete" method="POST" onsubmit="return confirm('Are you sure you want to delete department &quot;<%= dept.name %>&quot;?');" style="margin: 0;">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <button type="submit" class="btn btn-ghost btn-sm text-danger" style="color: #ef4444;">
                                🗑️ Delete
                            </button>
                        </form>
                    <% } else { %>
                        <span class="text-muted text-xs" title="Department cannot be deleted while employees are assigned.">Active Line</span>
                    <% } %>
                </div>
            </div>
        <% }) %>
    <% } %>
</div>

<!-- Unassigned Employees Section -->
<% if (unassignedEmployees && unassignedEmployees.length > 0) { %>
    <div id="unassignedSection" class="card mb-4" style="border-left: 4px solid #f59e0b;">
        <div class="card-header" style="background: rgba(245, 158, 11, 0.05);">
            <h3 style="color: #b45309;">⚠️ Unassigned Employees (<%= unassignedEmployees.length %>)</h3>
        </div>
        <div class="card-body" style="padding: 0;">
            <div class="table-responsive">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Employee ID</th>
                            <th>Full Name</th>
                            <th>Warehouse</th>
                            <th>Position</th>
                            <th class="text-right">Assign Department</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% unassignedEmployees.forEach(e => { %>
                            <tr>
                                <td><strong><%= e.employee_id %></strong></td>
                                <td><%= e.full_name %></td>
                                <td><%= e.area_name %></td>
                                <td><%= e.position_title || '—' %></td>
                                <td class="text-right">
                                    <button type="button" class="btn btn-sm btn-primary" onclick="openReassignModal(<%= e.id %>, '<%= e.full_name.replace(/'/g, "\\'") %>', '')">
                                        Assign to Department
                                    </button>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
<% } %>

<!-- Modal: Add Department -->
<div id="addDeptModal" class="modal-backdrop" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 9999; align-items: center; justify-content: center;">
    <div class="card" style="width: 100%; max-width: 440px; margin: 16px; box-shadow: 0 20px 25px -5px rgba(0,0,0,0.3);">
        <div class="card-header" style="display: flex; justify-content: space-between; align-items: center;">
            <h3 style="margin: 0;">➕ Create New Department</h3>
            <button type="button" class="btn btn-ghost btn-sm" onclick="closeModal('addDeptModal')">&times;</button>
        </div>
        <div class="card-body">
            <form action="/departments" method="POST" id="addDeptForm">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                <% if (areas.length > 0 && user.role !== 'COORDINATOR') { %>
                    <div class="form-group mb-3">
                        <label for="modal_area_id">Target Warehouse <span class="required">*</span></label>
                        <select name="area_id" id="modal_area_id" class="form-control" required>
                            <% areas.forEach(a => { %>
                                <option value="<%= a.id %>" <%= selectedAreaId === a.id ? 'selected' : '' %>><%= a.name %></option>
                            <% }) %>
                        </select>
                    </div>
                <% } %>

                <div class="form-group mb-3">
                    <label for="new_dept_name">Department Name <span class="required">*</span></label>
                    <input type="text" id="new_dept_name" name="name" class="form-control" placeholder="e.g. PH LAG12, Sorting Line B" required autofocus>
                    <div class="form-help">Enter the unique operational name for this department.</div>
                </div>

                <div class="form-group mb-4">
                    <label for="new_dept_desc">Description / Notes</label>
                    <input type="text" id="new_dept_desc" name="description" class="form-control" placeholder="Optional description">
                </div>

                <div style="display: flex; justify-content: flex-end; gap: 8px;">
                    <button type="button" class="btn btn-outline" onclick="closeModal('addDeptModal')">Cancel</button>
                    <button type="submit" class="btn btn-primary">Create Department</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Edit Department -->
<div id="editDeptModal" class="modal-backdrop" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 9999; align-items: center; justify-content: center;">
    <div class="card" style="width: 100%; max-width: 440px; margin: 16px; box-shadow: 0 20px 25px -5px rgba(0,0,0,0.3);">
        <div class="card-header" style="display: flex; justify-content: space-between; align-items: center;">
            <h3 style="margin: 0;">✏️ Rename Department</h3>
            <button type="button" class="btn btn-ghost btn-sm" onclick="closeModal('editDeptModal')">&times;</button>
        </div>
        <div class="card-body">
            <form action="" method="POST" id="editDeptForm">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                <div class="form-group mb-3">
                    <label for="edit_dept_name">Department Name <span class="required">*</span></label>
                    <input type="text" id="edit_dept_name" name="name" class="form-control" required>
                </div>

                <div class="form-group mb-4">
                    <label for="edit_dept_desc">Description</label>
                    <input type="text" id="edit_dept_desc" name="description" class="form-control">
                </div>

                <div style="display: flex; justify-content: flex-end; gap: 8px;">
                    <button type="button" class="btn btn-outline" onclick="closeModal('editDeptModal')">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Reassign Employee -->
<div id="reassignModal" class="modal-backdrop" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 9999; align-items: center; justify-content: center;">
    <div class="card" style="width: 100%; max-width: 440px; margin: 16px; box-shadow: 0 20px 25px -5px rgba(0,0,0,0.3);">
        <div class="card-header" style="display: flex; justify-content: space-between; align-items: center;">
            <h3 style="margin: 0;">🔄 Assign Employee to Department</h3>
            <button type="button" class="btn btn-ghost btn-sm" onclick="closeModal('reassignModal')">&times;</button>
        </div>
        <div class="card-body">
            <form action="/departments/assign-employee" method="POST" id="reassignForm">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="employee_id" id="reassign_employee_id">

                <div class="mb-3">
                    <span class="text-xs text-muted uppercase font-semibold">Employee</span>
                    <h4 id="reassign_employee_name" style="margin: 4px 0 0 0; color: var(--color-gray-900);">—</h4>
                </div>

                <div class="form-group mb-4">
                    <label for="reassign_department_id">Select New Department <span class="required">*</span></label>
                    <select name="department_id" id="reassign_department_id" class="form-control" required>
                        <option value="">-- Choose Department --</option>
                        <% departments.forEach(d => { %>
                            <option value="<%= d.id %>"><%= d.name %> (<%= d.area_name %>)</option>
                        <% }) %>
                    </select>
                </div>

                <div style="display: flex; justify-content: flex-end; gap: 8px;">
                    <button type="button" class="btn btn-outline" onclick="closeModal('reassignModal')">Cancel</button>
                    <button type="submit" class="btn btn-primary">Update Assignment</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
function toggleDeptStaff(id) {
    const el = document.getElementById(id);
    if (!el) return;
    el.style.display = el.style.display === 'none' ? 'block' : 'none';
}

function openAddDeptModal() {
    document.getElementById('addDeptModal').style.display = 'flex';
    document.getElementById('new_dept_name').focus();
}

function openEditDeptModal(id, name, desc) {
    const form = document.getElementById('editDeptForm');
    form.action = '/departments/' + id + '/edit';
    document.getElementById('edit_dept_name').value = name;
    document.getElementById('edit_dept_desc').value = desc || '';
    document.getElementById('editDeptModal').style.display = 'flex';
    document.getElementById('edit_dept_name').focus();
}

function openReassignModal(empId, empName, currentDeptId) {
    document.getElementById('reassign_employee_id').value = empId;
    document.getElementById('reassign_employee_name').textContent = empName;
    const select = document.getElementById('reassign_department_id');
    if (select) {
        select.value = currentDeptId || '';
    }
    document.getElementById('reassignModal').style.display = 'flex';
}

function closeModal(modalId) {
    const modal = document.getElementById(modalId);
    if (modal) modal.style.display = 'none';
}

// Close modal when clicking backdrop
document.querySelectorAll('.modal-backdrop').forEach(modal => {
    modal.addEventListener('click', (e) => {
        if (e.target === modal) {
            modal.style.display = 'none';
        }
    });
});
</script>

<%- include('../partials/layout-bottom') %>

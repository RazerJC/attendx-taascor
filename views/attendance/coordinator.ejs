<%- include('../partials/layout-top') %>

<% if (isCoordinator) { %>
    <div class="page-header">
        <div>
            <h2>My Daily Attendance</h2>
            <div class="breadcrumb">
                <span>Record your work shift with tamper-proof server timestamps</span>
            </div>
        </div>
    </div>

    <!-- Today's Clock In/Out Card -->
    <div class="card mb-3" style="max-width: 600px;">
        <div class="card-header">
            <h3>⏱️ Today's Shift (<%= formatDate(today) %>)</h3>
        </div>
        <div class="card-body">
            <% if (!todayRecord) { %>
                <p style="color: var(--color-gray-600); margin-bottom: 20px;">
                    You have not recorded your Time-In for today yet. Click below to begin your shift.
                </p>
                <form action="/coordinator-attendance/time-in" method="POST">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="btn btn-success btn-lg btn-block">
                        ⏱️ Record Time-In
                    </button>
                </form>
            <% } else { %>
                <div style="background: var(--color-gray-50); border: 1px solid var(--color-gray-200); border-radius: 6px; padding: 16px; margin-bottom: 20px;">
                    <div style="display: flex; justify-content: space-between; margin-bottom: 8px;">
                        <span>Time-In:</span>
                        <strong style="color: var(--color-success); font-size: 1.1rem;"><%= formatTime(todayRecord.time_in) %></strong>
                    </div>
                    <div style="display: flex; justify-content: space-between;">
                        <span>Time-Out:</span>
                        <strong style="color: var(--color-primary); font-size: 1.1rem;">
                            <%= todayRecord.time_out ? formatTime(todayRecord.time_out) : 'Not yet recorded' %>
                        </strong>
                    </div>
                </div>

                <% if (!todayRecord.time_out) { %>
                    <form action="/coordinator-attendance/time-out" method="POST">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button type="submit" class="btn btn-primary btn-lg btn-block">
                            ⏱️ Record Time-Out
                        </button>
                    </form>
                <% } else { %>
                    <div class="alert alert-success" style="margin-bottom: 0;">
                        ✓ Your shift for today has been logged and completed.
                    </div>
                <% } %>
            <% } %>
        </div>
    </div>

    <!-- Attendance History & Correction Request -->
    <div class="card">
        <div class="card-header">
            <h3>Attendance Log (Last 30 Days)</h3>
        </div>
        <div class="card-body" style="padding: 0;">
            <div class="table-responsive">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Time In</th>
                            <th>Time Out</th>
                            <th>Status / Correction</th>
                            <th class="text-right">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (history.length === 0) { %>
                            <tr><td colspan="5" class="text-center">No attendance records found.</td></tr>
                        <% } else { %>
                            <% history.forEach(r => { %>
                                <tr>
                                    <td><%= formatDate(r.work_date) %></td>
                                    <td><strong style="color: var(--color-success);"><%= formatTime(r.time_in) %></strong></td>
                                    <td><strong style="color: var(--color-primary);"><%= r.time_out ? formatTime(r.time_out) : '—' %></strong></td>
                                    <td>
                                        <% if (r.correction_requested) { %>
                                            <span class="badge badge-warning">Correction Pending HR Review</span>
                                        <% } else if (r.correction_approved_by) { %>
                                            <span class="badge badge-info">Correction Approved: <%= r.correction_note || '' %></span>
                                        <% } else if (r.time_out) { %>
                                            <span class="badge badge-success">Completed</span>
                                        <% } else { %>
                                            <span class="badge badge-info">In Progress</span>
                                        <% } %>
                                    </td>
                                    <td class="text-right">
                                        <% if (!r.correction_requested) { %>
                                            <button type="button" class="btn btn-ghost btn-sm" onclick="openCorrectionForm('<%= r.id %>', '<%= r.work_date %>')">
                                                Request Correction
                                            </button>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Modal for Correction -->
    <div id="correctionModal" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 200; align-items: center; justify-content: center;">
        <div class="card" style="max-width: 500px; width: 90%; margin: auto; background: white;">
            <div class="card-header">
                <h3>Request Attendance Correction</h3>
                <button type="button" class="alert-close" onclick="document.getElementById('correctionModal').style.display='none'">×</button>
            </div>
            <div class="card-body">
                <form action="/coordinator-attendance/request-correction" method="POST">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <input type="hidden" name="attendance_id" id="modalAttendanceId">

                    <p style="font-size: 0.85rem; color: var(--color-gray-600); margin-bottom: 16px;">
                        Date: <strong id="modalWorkDate"></strong><br>
                        Coordinators cannot freely overwrite timestamps. Provide details for HR review.
                    </p>

                    <div class="form-group">
                        <label for="correction_reason">Reason & Correct Times <span class="required">*</span></label>
                        <textarea id="correction_reason" name="correction_reason" class="form-control" rows="3" placeholder="e.g. Forgot to punch out due to emergency. Actual time out was 18:00" required></textarea>
                    </div>

                    <div class="btn-group">
                        <button type="submit" class="btn btn-primary">Submit to HR</button>
                        <button type="button" class="btn btn-outline" onclick="document.getElementById('correctionModal').style.display='none'">Cancel</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script>
    function openCorrectionForm(id, date) {
        document.getElementById('modalAttendanceId').value = id;
        document.getElementById('modalWorkDate').textContent = date;
        const modal = document.getElementById('correctionModal');
        modal.style.display = 'flex';
    }
    </script>

<% } else { %>
    <!-- HR and Admin Monitoring View -->
    <div class="page-header">
        <div>
            <h2>Coordinator Attendance Monitoring</h2>
            <div class="breadcrumb">
                <span>Review coordinator duty logs and attendance correction requests</span>
            </div>
        </div>
    </div>

    <!-- Pending Corrections Section -->
    <% if (pendingCorrections.length > 0) { %>
        <div class="card mb-3" style="border-left: 4px solid var(--color-warning);">
            <div class="card-header">
                <h3>⚠️ Pending Correction Requests (<%= pendingCorrections.length %>)</h3>
            </div>
            <div class="card-body">
                <% pendingCorrections.forEach(c => { %>
                    <div style="background: var(--color-gray-50); border: 1px solid var(--color-gray-200); border-radius: 6px; padding: 16px; margin-bottom: 12px;">
                        <div style="display: flex; justify-content: space-between; margin-bottom: 8px;">
                            <strong><%= c.full_name %> (<%= c.area_name || 'Warehouse' %>)</strong>
                            <span>Date: <%= formatDate(c.work_date) %></span>
                        </div>
                        <p style="font-size: 0.85rem; color: var(--color-gray-700); margin-bottom: 12px;">
                            <strong>Reason:</strong> <%= c.correction_reason %>
                        </p>
                        <form action="/coordinator-attendance/approve-correction" method="POST" class="form-row" style="align-items: flex-end;">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <input type="hidden" name="attendance_id" value="<%= c.id %>">
                            <div class="form-group" style="margin-bottom: 0;">
                                <label>Adjusted Time-In</label>
                                <input type="time" name="new_time_in" class="form-control" value="<%= c.time_in %>">
                            </div>
                            <div class="form-group" style="margin-bottom: 0;">
                                <label>Adjusted Time-Out</label>
                                <input type="time" name="new_time_out" class="form-control" value="<%= c.time_out || '17:00' %>">
                            </div>
                            <div class="form-group" style="margin-bottom: 0; flex: 2;">
                                <label>HR Note</label>
                                <input type="text" name="hr_notes" class="form-control" placeholder="Approval note">
                            </div>
                            <button type="submit" class="btn btn-success">Approve Correction</button>
                        </form>
                    </div>
                <% }) %>
            </div>
        </div>
    <% } %>

    <!-- Daily Log for All Coordinators -->
    <div class="filter-bar">
        <form method="GET" action="/coordinator-attendance" style="display: flex; gap: 12px; align-items: flex-end;">
            <div class="filter-group">
                <label for="filter_date">Date</label>
                <input type="date" id="filter_date" name="date" class="form-control" value="<%= filterDate %>" onchange="this.form.submit()">
            </div>
        </form>
    </div>

    <div class="card">
        <div class="card-body" style="padding: 0;">
            <div class="table-responsive">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Coordinator</th>
                            <th>Warehouse / Area</th>
                            <th>Time In</th>
                            <th>Time Out</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (records.length === 0) { %>
                            <tr><td colspan="5" class="text-center">No coordinators recorded for this date.</td></tr>
                        <% } else { %>
                            <% records.forEach(r => { %>
                                <tr>
                                    <td><strong><%= r.full_name %></strong></td>
                                    <td><%= r.area_name || 'Unassigned' %></td>
                                    <td>
                                        <% if (r.time_in) { %>
                                            <span style="color: var(--color-success); font-weight: 600;"><%= formatTime(r.time_in) %></span>
                                        <% } else { %>
                                            <span class="text-muted">Not recorded</span>
                                        <% } %>
                                    </td>
                                    <td>
                                        <% if (r.time_out) { %>
                                            <span style="color: var(--color-primary); font-weight: 600;"><%= formatTime(r.time_out) %></span>
                                        <% } else { %>
                                            <span class="text-muted">—</span>
                                        <% } %>
                                    </td>
                                    <td>
                                        <% if (r.correction_requested) { %>
                                            <span class="badge badge-warning">Correction Pending</span>
                                        <% } else if (r.time_out) { %>
                                            <span class="badge badge-success">Completed</span>
                                        <% } else if (r.time_in) { %>
                                            <span class="badge badge-info">On Duty</span>
                                        <% } else { %>
                                            <span class="badge badge-secondary">Pending</span>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
<% } %>

<%- include('../partials/layout-bottom') %>

<%- include('../partials/layout-top') %>

<% 
    const curDt = DateTime.fromISO(workDate, { zone: 'Asia/Manila' });
    const dayName = curDt.toFormat('EEEE');
    const formattedFull = curDt.toFormat('MMMM dd, yyyy');
    const isCoord = (typeof isCoordinator !== 'undefined' && isCoordinator) || (user && user.role === 'COORDINATOR');
%>

<!-- ============================================================ -->
<!-- 1. TOP COMMAND BAR: DATE, COUNTERS & ACTIONS (COMPACT)       -->
<!-- ============================================================ -->
<div class="page-header"><div><h2>Daily attendance</h2><p class="text-muted">Mark today's attendance here. Saved entries remain available in Attendance records.</p></div><a class="btn btn-outline" href="/reports">Attendance records</a></div>
<p class="form-help" style="margin-bottom: 12px;"><strong><%= totalEmployees - summary.unrecorded %> saved records</strong> for <%= formattedFull %>. <a href="/reports?date_from=<%= workDate %>&amp;date_to=<%= workDate %><%= selectedAreaId ? '&area_id=' + selectedAreaId : '' %>">View saved attendance for this date</a></p>
<div class="card p-2 mb-2 att-top-bar" style="border: 1px solid #e2e8f0; border-radius: 8px; background: white; box-shadow: 0 1px 2px rgba(0,0,0,0.03);">
    <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8px;">
        
        <!-- Left: Date & Restrictions -->
        <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
            <div style="display: flex; align-items: center; gap: 6px;">
                <span style="font-size: 1.1rem;">📅</span>
                <div style="display: flex; align-items: baseline; gap: 5px;">
                    <strong style="font-size: 0.88rem; color: #0f172a; font-weight: 800;"><%= dayName %></strong>
                    <span style="color: #64748b; font-size: 0.78rem;"><%= formattedFull %></span>
                    <% if (isPastDate) { %>
                        <span class="badge badge-warning" style="font-size: 0.62rem; padding: 1px 5px;">Past</span>
                    <% } else if (isFutureDate) { %>
                        <span class="badge badge-info" style="font-size: 0.62rem; padding: 1px 5px;">Future</span>
                    <% } else { %>
                        <span class="badge badge-success" style="font-size: 0.62rem; padding: 1px 5px;">Today</span>
                    <% } %>
                </div>
            </div>

            <!-- Date Picker for Admin/HR or Locked Badge for Coordinator -->
            <% if (isCoord) { %>
                <div class="coordinator-lock-pill" style="display: flex; align-items: center; gap: 5px; background: #f8fafc; border: 1px solid #cbd5e1; padding: 2px 8px; border-radius: 6px; font-size: 0.72rem;">
                    <span>🔒</span>
                    <span style="font-weight: 700; color: #334155;">Fixed Date:</span>
                    <span style="color: #0f172a;"><%= formattedFull %></span>
                </div>
            <% } else { %>
                <form method="GET" action="/attendance" style="display: flex; align-items: center; gap: 4px; margin: 0;">
                    <% if (areas.length > 0 && selectedAreaId) { %>
                        <input type="hidden" name="area_id" value="<%= selectedAreaId %>">
                    <% } %>
                    <input type="date" name="date" value="<%= workDate %>" class="form-control form-control-sm" style="width: 118px; padding: 2px 6px; font-size: 0.75rem; height: 26px;" onchange="this.form.submit()">
                    <a href="/attendance?date=<%= today %><%= selectedAreaId ? '&area_id=' + selectedAreaId : '' %>" class="btn btn-outline btn-xs" style="font-size: 0.7rem; padding: 2px 6px; height: 26px; display: inline-flex; align-items: center;">
                        📍 Today
                    </a>
                </form>
            <% } %>
        </div>

        <!-- Center: Live Counter Chips (Crisp & Compact) -->
        <div class="att-counter-strip" style="display: flex; align-items: center; gap: 4px; flex-wrap: wrap;">
            <div class="counter-chip chip-p" title="Filter Present" onclick="quickFilterStatus('present')">
                <span class="dot">●</span> <strong><span id="stat_p"><%= summary.present %></span></strong> P
            </div>
            <div class="counter-chip chip-a" title="Filter Absent" onclick="quickFilterStatus('absent')">
                <span class="dot">●</span> <strong><span id="stat_a"><%= summary.absent %></span></strong> A
            </div>
            <div class="counter-chip chip-nw" title="Filter No Work" onclick="quickFilterStatus('no_work')">
                <span class="dot">●</span> <strong><span id="stat_nw"><%= summary.no_work %></span></strong> NW
            </div>
            <div class="counter-chip chip-sl" title="Filter Leave" onclick="quickFilterStatus('leave')">
                <span class="dot">●</span> <strong><span id="stat_sl"><%= summary.leave %></span></strong> SL
            </div>
            <div class="counter-chip chip-sh" title="Filter Sent Home" onclick="quickFilterStatus('sent_home')">
                <span class="dot">●</span> <strong><span id="stat_sh"><%= summary.sent_home %></span></strong> SH
            </div>
            <div class="counter-chip chip-rd" title="Filter Rest Day" onclick="quickFilterStatus('rest_day')">
                <span class="dot">●</span> <strong><span id="stat_rd"><%= summary.rest_day %></span></strong> RD
            </div>
            <div class="counter-chip chip-un" title="Filter Unrecorded" onclick="quickFilterStatus('unrecorded')">
                <strong><span id="stat_un"><%= summary.unrecorded %></span></strong> Unrecorded
            </div>
        </div>

        <!-- Right: Actions -->
        <div style="display: flex; align-items: center; gap: 6px;">
            <button type="button" class="btn btn-outline btn-xs" id="btnMarkAllPresent" onclick="markAllVisible('present')" title="Click to Mark all as Present, or click again to uncheck all" style="font-size: 0.74rem; padding: 4px 10px; height: 28px; font-weight: 700;">
                ⚡ All Present
            </button>
            <button type="button" class="btn btn-primary btn-xs" onclick="document.getElementById('attendanceForm').requestSubmit()" style="font-weight: 700; font-size: 0.75rem; padding: 4px 12px; height: 28px; box-shadow: 0 1px 3px rgba(37,99,235,0.2);">
                💾 Save changes (<span id="topPendingCount">0</span> unsaved)
            </button>
        </div>
    </div>
</div>

<!-- ============================================================ -->
<!-- 2. UNIFIED WORKSPACE TOOLBAR: SEARCH, FILTERS & CONTROLS     -->
<!-- ============================================================ -->
<form method="POST" action="/attendance" id="attendanceForm">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="work_date" value="<%= workDate %>">

    <div class="card p-2 mb-2 att-workspace-toolbar" style="background: white; border: 1px solid #e2e8f0; border-radius: 8px;">
        <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8px;">
            
            <!-- Left: Search Box -->
            <div style="position: relative; width: 240px;">
                <span style="position: absolute; left: 8px; top: 50%; transform: translateY(-50%); font-size: 0.75rem; color: #94a3b8; pointer-events: none;">🔍</span>
                <input type="text" id="employeeSearchInput" placeholder="Search name, pos, ID..." 
                       class="form-control form-control-sm" style="padding-left: 26px; border-radius: 6px; font-size: 0.74rem; height: 28px;">
            </div>

            <!-- Filters & Layout Controls -->
            <div style="display: flex; align-items: center; gap: 6px; flex-wrap: wrap;">
                <!-- Sort -->
                <select id="sortBySelect" class="form-control form-control-sm compact-select" onchange="applySortingAndFiltering()">
                    <option value="dept" selected>📁 By Dept</option>
                    <option value="name_asc">🔤 Name A-Z</option>
                    <option value="name_desc">🔤 Name Z-A</option>
                    <option value="pos">💼 Position</option>
                    <option value="status_unrecorded">⏳ Unrecorded</option>
                    <option value="status_present">🟢 Present</option>
                </select>

                <!-- Status Filter -->
                <select id="filterStatusSelect" class="form-control form-control-sm compact-select" onchange="applySortingAndFiltering()">
                    <option value="all">All Status</option>
                    <option value="unrecorded">Unrecorded</option>
                    <option value="present">Present (P)</option>
                    <option value="absent">Absent (A)</option>
                    <option value="no_work">No Work (NW)</option>
                    <option value="leave">Leave (SL)</option>
                    <option value="sent_home">Sent Home (SH)</option>
                    <option value="rest_day">Rest Day (RD)</option>
                </select>

                <!-- View Mode Switch: Table vs Kanban Grid -->
                <div class="view-mode-toggle" style="display: inline-flex; background: #f1f5f9; padding: 2px; border-radius: 6px; border: 1px solid #e2e8f0;">
                    <button type="button" class="view-toggle-btn active" id="viewBtnTable" onclick="switchViewDisplay('table')" title="Table List View">
                        📋 Table
                    </button>
                    <button type="button" class="view-toggle-btn" id="viewBtnKanban" onclick="switchViewDisplay('kanban')" title="Kanban Cards Grid">
                        🗂️ Cards
                    </button>
                </div>

                <!-- Global Fold / Unfold -->
                <div style="display: flex; align-items: center; gap: 3px;">
                    <button type="button" class="btn btn-outline btn-xs" onclick="foldAllDepartments()" style="font-size: 0.7rem; padding: 3px 8px; height: 28px; color: #475569;" title="Fold all departments">
                        📁 Fold All
                    </button>
                    <button type="button" class="btn btn-outline btn-xs" onclick="unfoldAllDepartments()" style="font-size: 0.7rem; padding: 3px 8px; height: 28px; color: #475569;" title="Unfold all departments">
                        📖 Unfold All
                    </button>
                </div>

                <button type="button" class="btn btn-outline btn-xs" onclick="openAddDeptModal()" style="font-size: 0.7rem; height: 28px; padding: 2px 8px;">
                    ➕ Dept
                </button>
            </div>
        </div>
    </div>

    <!-- Hidden Form Inputs Container -->
    <div id="hiddenInputsContainer">
        <% employees.forEach(emp => { 
            const currentStatus = emp.att_status ? (emp.att_status === 'on_leave' ? 'leave' : emp.att_status) : '';
        %>
            <input type="hidden" name="attendance[e_<%= emp.id %>][status]" id="statusInput_<%= emp.id %>" data-status-input="<%= emp.id %>" value="<%= currentStatus %>">
            <% if (emp.schedule_id) { %>
                <input type="hidden" name="attendance[e_<%= emp.id %>][schedule_id]" value="<%= emp.schedule_id %>">
            <% } %>
        <% }) %>
    </div>

    <!-- No Match Alert -->
    <div id="noMatchesNotice" class="card p-3 text-center mb-3" style="display: none; border: 1px dashed #cbd5e1;">
        <p class="text-muted" style="margin: 0; font-size: 0.78rem;">No staff match the current search or filters.</p>
    </div>

    <!-- ============================================================ -->
    <!-- 3. UNIFIED DEPARTMENT ATTENDANCE BOARD (FOLDABLE BY DEPT)    -->
    <!-- ============================================================ -->
    <div id="unifiedBoard" class="unified-dept-container display-table">
        <% groupedDepartments.forEach(dept => { 
            const posKeys = Object.keys(dept.positions);
            let allDeptEmps = [];
            posKeys.forEach(pk => dept.positions[pk].forEach(e => allDeptEmps.push(e)));
            if (allDeptEmps.length === 0 && dept.id === 0) return;
        %>
            <div class="dept-block card mb-2" id="dept_card_<%= dept.id %>" data-forum-dept="<%= dept.id %>" style="border: 1px solid #e2e8f0; border-radius: 8px; overflow: hidden; background: white; transition: all 0.15s ease;">
                
                <!-- Department Header Bar (Click to Fold/Unfold) -->
                <div class="dept-header-strip" onclick="toggleDeptFold(<%= dept.id %>)">
                    <div style="display: flex; align-items: center; gap: 8px;">
                        <span class="dept-fold-icon" id="dept_fold_icon_<%= dept.id %>">▼</span>
                        <input type="checkbox" class="dept-select-all" id="deptCheck_<%= dept.id %>" onclick="event.stopPropagation();" onchange="toggleDeptCheckboxes(<%= dept.id %>, this.checked)" title="Select all in department">
                        
                        <div style="display: flex; align-items: center; gap: 6px;">
                            <strong class="dept-title-text"><%= dept.name %></strong>
                            <span class="dept-count-pill"><%= allDeptEmps.length %> Staff</span>
                        </div>
                    </div>

                    <!-- Right Controls on Header -->
                    <div style="display: flex; align-items: center; gap: 8px;">
                        <!-- Live Progress Counter -->
                        <div class="dept-progress-text">
                            Marked: <strong id="dept_marked_count_<%= dept.id %>">--</strong> / <%= allDeptEmps.length %>
                        </div>

                        <!-- 1-Click Action Buttons -->
                        <div style="display: flex; align-items: center; gap: 4px;" onclick="event.stopPropagation();">
                            <button type="button" class="btn btn-xs btn-outline batch-quick-btn btn-p" onclick="markAllDept(<%= dept.id %>, 'present')" title="Mark all Present in this department">
                                ⚡ All P
                            </button>
                            <button type="button" class="btn btn-xs btn-outline batch-quick-btn btn-rd" onclick="markAllDept(<%= dept.id %>, 'rest_day')" title="Mark all Rest Day in this department">
                                ⚡ All RD
                            </button>
                            <button type="button" class="btn btn-xs btn-outline batch-quick-btn btn-nw" onclick="markAllDept(<%= dept.id %>, 'no_work')" title="Mark all No Work in this department">
                                ⚡ All NW
                            </button>
                        </div>

                        <span class="folded-pill" id="dept_folded_tag_<%= dept.id %>" style="display: none;">
                            FOLDED (EXPAND)
                        </span>
                    </div>
                </div>

                <!-- Department Body Container (Foldable) -->
                <div class="dept-body-container" id="dept_body_<%= dept.id %>">
                    
                    <!-- DISPLAY MODE 1: COMPACT TABLE (SPREADSHEET PRECISION) -->
                    <div class="view-table-wrapper">
                        <table class="compact-att-table">
                            <thead>
                                <tr>
                                    <th style="width: 30px; text-align: center;"></th>
                                    <th style="width: 32px; text-align: center;">#</th>
                                    <th style="width: 85px;">ID</th>
                                    <th style="min-width: 180px;">STAFF NAME</th>
                                    <th style="width: 130px;">POSITION</th>
                                    <th style="min-width: 250px;">ATTENDANCE STATUS</th>
                                    <th style="width: 130px;">SHIFT / SCHEDULE</th>
                                    <th style="width: 60px; text-align: center;">EDIT</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% let rowIdx = 1; %>
                                <% allDeptEmps.forEach(emp => { 
                                    const currentStatus = emp.att_status ? (emp.att_status === 'on_leave' ? 'leave' : emp.att_status) : '';
                                    const initials = ((emp.first_name ? emp.first_name[0] : '') + (emp.last_name ? emp.last_name[0] : '')).toUpperCase();
                                %>
                                    <tr class="emp-master-item compact-row <%= currentStatus ? 'st-row-' + currentStatus : 'st-row-unrecorded' %>"
                                        id="emp_row_<%= emp.id %>"
                                        data-emp-id="<%= emp.id %>" 
                                        data-emp-name="<%= emp.last_name %>, <%= emp.first_name %>"
                                        data-emp-dept="<%= dept.id %>"
                                        data-emp-deptname="<%= dept.name %>"
                                        data-emp-pos="<%= emp.position_title || 'Worker' %>"
                                        data-emp-status="<%= currentStatus %>">
                                        
                                        <!-- Checkbox -->
                                        <td style="text-align: center;" onclick="event.stopPropagation();">
                                            <input type="checkbox" class="mass-emp-checkbox" value="<%= emp.id %>" data-dept-id="<%= dept.id %>" onchange="updateBatchDock()">
                                        </td>

                                        <!-- Index -->
                                        <td class="cell-idx"><%= rowIdx++ %></td>

                                        <!-- Employee ID -->
                                        <td>
                                            <span class="compact-id-tag"><%= emp.employee_id %></span>
                                        </td>

                                        <!-- Name with micro avatar -->
                                        <td>
                                            <div style="display: flex; align-items: center; gap: 6px;">
                                                <div class="micro-avatar"><%= initials %></div>
                                                <strong class="compact-name-text"><%= emp.last_name %>, <%= emp.first_name %></strong>
                                                <% if (emp.open_btw_id) { %>
                                                    <span class="badge badge-warning" style="font-size: 0.6rem; padding: 1px 3px;" title="Open BTW Clearance">BTW</span>
                                                <% } %>
                                            </div>
                                        </td>

                                        <!-- Position -->
                                        <td>
                                            <span class="compact-pos-tag"><%= emp.position_title || 'Worker' %></span>
                                        </td>

                                        <!-- Status Cell with Segmented Buttons -->
                                        <td class="cell-status-wrapper" id="status_cell_<%= emp.id %>">
                                            <div class="forum-seg-control micro" data-seg-emp="<%= emp.id %>" onclick="event.stopPropagation();">
                                                <button type="button" onclick="handleStatusClick(<%= emp.id %>, 'present')" class="seg-btn seg-p <%= currentStatus === 'present' ? 'active' : '' %>" title="Present">P</button>
                                                <button type="button" onclick="handleStatusClick(<%= emp.id %>, 'absent')" class="seg-btn seg-a <%= currentStatus === 'absent' ? 'active' : '' %>" title="Absent">A</button>
                                                <button type="button" onclick="handleStatusClick(<%= emp.id %>, 'no_work')" class="seg-btn seg-nw <%= currentStatus === 'no_work' ? 'active' : '' %>" title="No Work">NW</button>
                                                <button type="button" onclick="handleStatusClick(<%= emp.id %>, 'leave')" class="seg-btn seg-sl <%= (currentStatus === 'leave' || currentStatus === 'on_leave') ? 'active' : '' %>" title="Leave">SL</button>
                                                <button type="button" onclick="handleStatusClick(<%= emp.id %>, 'sent_home')" class="seg-btn seg-sh <%= currentStatus === 'sent_home' ? 'active' : '' %>" title="Sent Home">SH</button>
                                                <button type="button" onclick="handleStatusClick(<%= emp.id %>, 'rest_day')" class="seg-btn seg-rd <%= currentStatus === 'rest_day' ? 'active' : '' %>" title="Rest Day">RD</button>
                                            </div>
                                            <span class="status-indicator-tag" id="tag_<%= emp.id %>"><%= currentStatus ? currentStatus.toUpperCase() : 'UNRECORDED' %></span>
                                            <span class="change-tag" id="change_<%= emp.id %>" style="display: none;">●</span>
                                        </td>

                                        <!-- Schedule -->
                                        <td style="font-size: 0.7rem; color: #64748b;">
                                            <% if (emp.is_rest_day) { %>
                                                <span style="color: #ea580c; font-weight: 600;">🌴 Sched RD</span>
                                            <% } else if (emp.shift_start && emp.shift_end) { %>
                                                <%= emp.shift_start %> - <%= emp.shift_end %>
                                            <% } else { %>
                                                Regular 8h
                                            <% } %>
                                        </td>

                                        <!-- Edit Action -->
                                        <td style="text-align: center;" onclick="event.stopPropagation();">
                                            <button type="button" class="btn btn-ghost btn-xs" style="font-size: 0.7rem; padding: 1px 4px;" onclick="openEditEmpModal(<%= emp.id %>, '<%= emp.first_name %>', '<%= emp.last_name %>', '<%= emp.position_title || '' %>', <%= emp.department_id || 'null' %>)" title="Edit Employee">
                                                ✏️
                                            </button>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>

                    <!-- DISPLAY MODE 2: COMPACT KANBAN CARDS GRID -->
                    <div class="view-kanban-wrapper">
                        <div class="compact-cards-grid">
                            <% allDeptEmps.forEach(emp => { 
                                const currentStatus = emp.att_status ? (emp.att_status === 'on_leave' ? 'leave' : emp.att_status) : '';
                                const initials = ((emp.first_name ? emp.first_name[0] : '') + (emp.last_name ? emp.last_name[0] : '')).toUpperCase();
                            %>
                                <div class="emp-master-item compact-card <%= currentStatus ? 'st-card-' + currentStatus : 'st-card-unrecorded' %>"
                                     id="card_<%= emp.id %>"
                                     data-emp-id="<%= emp.id %>" 
                                     data-emp-name="<%= emp.last_name %>, <%= emp.first_name %>"
                                     data-emp-dept="<%= dept.id %>"
                                     data-emp-deptname="<%= dept.name %>"
                                     data-emp-pos="<%= emp.position_title || 'Worker' %>"
                                     data-emp-status="<%= currentStatus %>">
                                    
                                    <div style="display: flex; align-items: center; justify-content: space-between; gap: 4px; margin-bottom: 4px;">
                                        <div style="display: flex; align-items: center; gap: 5px; min-width: 0;">
                                            <input type="checkbox" class="mass-emp-checkbox" value="<%= emp.id %>" data-dept-id="<%= dept.id %>" onclick="event.stopPropagation();" onchange="updateBatchDock()">
                                            <div class="micro-avatar"><%= initials %></div>
                                            <div style="min-width: 0;">
                                                <strong class="compact-name-text text-truncate" style="display: block;" title="<%= emp.last_name %>, <%= emp.first_name %>">
                                                    <%= emp.last_name %>, <%= emp.first_name %>
                                                </strong>
                                                <span class="compact-id-tag"><%= emp.employee_id %></span>
                                            </div>
                                        </div>
                                        <span class="compact-pos-tag"><%= emp.position_title || 'Worker' %></span>
                                    </div>

                                    <div style="display: flex; align-items: center; justify-content: space-between; border-top: 1px solid #f1f5f9; padding-top: 4px; margin-top: 2px;">
                                        <span class="status-indicator-tag" id="card_tag_<%= emp.id %>"><%= currentStatus ? currentStatus.toUpperCase() : 'UNRECORDED' %></span>
                                        <div class="forum-seg-control micro" data-seg-emp="<%= emp.id %>" onclick="event.stopPropagation();">
                                            <button type="button" onclick="handleStatusClick(<%= emp.id %>, 'present')" class="seg-btn seg-p <%= currentStatus === 'present' ? 'active' : '' %>">P</button>
                                            <button type="button" onclick="handleStatusClick(<%= emp.id %>, 'absent')" class="seg-btn seg-a <%= currentStatus === 'absent' ? 'active' : '' %>">A</button>
                                            <button type="button" onclick="handleStatusClick(<%= emp.id %>, 'no_work')" class="seg-btn seg-nw <%= currentStatus === 'no_work' ? 'active' : '' %>">NW</button>
                                            <button type="button" onclick="handleStatusClick(<%= emp.id %>, 'leave')" class="seg-btn seg-sl <%= (currentStatus === 'leave' || currentStatus === 'on_leave') ? 'active' : '' %>">SL</button>
                                            <button type="button" onclick="handleStatusClick(<%= emp.id %>, 'sent_home')" class="seg-btn seg-sh <%= currentStatus === 'sent_home' ? 'active' : '' %>">SH</button>
                                            <button type="button" onclick="handleStatusClick(<%= emp.id %>, 'rest_day')" class="seg-btn seg-rd <%= currentStatus === 'rest_day' ? 'active' : '' %>">RD</button>
                                        </div>
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                    </div>

                </div>
            </div>
        <% }) %>
    </div>

    <!-- Sticky Floating Multi-Select Dock -->
    <div id="massBatchDock" class="mass-batch-dock" style="display: none;">
        <div style="display: flex; align-items: center; justify-content: space-between; gap: 10px; flex-wrap: wrap;">
            <div style="display: flex; align-items: center; gap: 6px;">
                <span style="font-size: 0.95rem;">⚡</span>
                <strong style="color: white; font-size: 0.78rem;"><span id="massSelectedCount">0</span> Selected</strong>
            </div>
            <div style="display: flex; align-items: center; gap: 4px; flex-wrap: wrap;">
                <button type="button" class="btn btn-xs" onclick="applyBatchStatus('present')" style="background: #22c55e; color: white; font-weight: 700; border: none; font-size: 0.7rem; padding: 3px 8px;">
                    Set Present
                </button>
                <button type="button" class="btn btn-xs" onclick="applyBatchStatus('absent')" style="background: #ef4444; color: white; font-weight: 700; border: none; font-size: 0.7rem; padding: 3px 8px;">
                    Set Absent
                </button>
                <button type="button" class="btn btn-xs" onclick="applyBatchStatus('rest_day')" style="background: #f97316; color: white; font-weight: 700; border: none; font-size: 0.7rem; padding: 3px 8px;">
                    Set Rest Day
                </button>
                <button type="button" class="btn btn-xs" onclick="applyBatchStatus('no_work')" style="background: #64748b; color: white; font-weight: 700; border: none; font-size: 0.7rem; padding: 3px 8px;">
                    Set No Work
                </button>
                <button type="button" class="btn btn-xs" onclick="applyBatchStatus('leave')" style="background: #a855f7; color: white; font-weight: 700; border: none; font-size: 0.7rem; padding: 3px 8px;">
                    Set Leave
                </button>
                <button type="button" class="btn btn-xs btn-outline" onclick="clearBatchSelection()" style="color: white; border-color: rgba(255,255,255,0.4); font-size: 0.7rem; padding: 3px 8px;">
                    ✕ Clear
                </button>
            </div>
        </div>

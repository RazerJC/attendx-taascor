<script>
let currentDisplayMode = 'table'; // 'table' or 'kanban'
let initialStatuses = {};

document.addEventListener('DOMContentLoaded', () => {
    // Record initial status of each employee from server
    document.querySelectorAll('[data-status-input]').forEach(input => {
        const empId = input.getAttribute('data-status-input');
        initialStatuses[empId] = input.value || '';
    });

    // Restore saved view mode preference (table or kanban)
    const savedMode = localStorage.getItem('tascor_display_mode') || 'table';
    switchViewDisplay(savedMode, false);

    updateLiveCounters();
    updatePendingCount();
    applySortingAndFiltering();

    // Search input listener
    const searchInput = document.getElementById('employeeSearchInput');
    if (searchInput) {
        searchInput.addEventListener('input', applySortingAndFiltering);
    }

    // Ctrl+S shortcut to save
    document.addEventListener('keydown', (e) => {
        if ((e.ctrlKey || e.metaKey) && e.key === 's') {
            e.preventDefault();
            document.getElementById('attendanceForm').requestSubmit();
        }
    });
});

// ============================================================
// VIEW DISPLAY SWITCHER (TABLE VS KANBAN CARDS)
// ============================================================
function switchViewDisplay(mode, savePref = true) {
    currentDisplayMode = mode;
    if (savePref) {
        localStorage.setItem('tascor_display_mode', mode);
    }

    const board = document.getElementById('unifiedBoard');
    const btnTable = document.getElementById('viewBtnTable');
    const btnKanban = document.getElementById('viewBtnKanban');

    if (mode === 'kanban') {
        if (board) {
            board.classList.remove('display-table');
            board.classList.add('display-kanban');
        }
        if (btnTable) btnTable.classList.remove('active');
        if (btnKanban) btnKanban.classList.add('active');
    } else {
        if (board) {
            board.classList.remove('display-kanban');
            board.classList.add('display-table');
        }
        if (btnTable) btnTable.classList.add('active');
        if (btnKanban) btnKanban.classList.remove('active');
    }
}

// ============================================================
// DEPARTMENT FOLD / COLLAPSE CONTROLS
// ============================================================
function toggleDeptFold(deptId) {
    const body = document.getElementById(`dept_body_${deptId}`);
    const icon = document.getElementById(`dept_fold_icon_${deptId}`);
    const card = document.getElementById(`dept_card_${deptId}`);
    const tag = document.getElementById(`dept_folded_tag_${deptId}`);

    if (!body) return;

    const isFolded = body.style.display === 'none';
    if (isFolded) {
        body.style.display = '';
        if (icon) icon.textContent = '▼';
        if (card) card.classList.remove('is-folded');
        if (tag) tag.style.display = 'none';
    } else {
        body.style.display = 'none';
        if (icon) icon.textContent = '▶';
        if (card) card.classList.add('is-folded');
        if (tag) tag.style.display = 'inline-block';
    }
}

function foldAllDepartments() {
    document.querySelectorAll('.dept-body-container').forEach(body => {
        body.style.display = 'none';
    });
    document.querySelectorAll('.dept-fold-icon').forEach(icon => {
        icon.textContent = '▶';
    });
    document.querySelectorAll('.dept-block').forEach(card => {
        card.classList.add('is-folded');
    });
    document.querySelectorAll('.folded-pill').forEach(tag => {
        tag.style.display = 'inline-block';
    });
}

function unfoldAllDepartments() {
    document.querySelectorAll('.dept-body-container').forEach(body => {
        body.style.display = '';
    });
    document.querySelectorAll('.dept-fold-icon').forEach(icon => {
        icon.textContent = '▼';
    });
    document.querySelectorAll('.dept-block').forEach(card => {
        card.classList.remove('is-folded');
    });
    document.querySelectorAll('.folded-pill').forEach(tag => {
        tag.style.display = 'none';
    });
}

// ============================================================
// ACCURATE PENDING CHANGES COUNTER (NO INFINITE MULTIPLYING)
// ============================================================
function updatePendingCount() {
    let count = 0;
    document.querySelectorAll('[data-status-input]').forEach(input => {
        const empId = input.getAttribute('data-status-input');
        const currentVal = input.value || '';
        const initialVal = initialStatuses[empId] || '';
        const isChanged = currentVal !== initialVal;

        if (isChanged) {
            count++;
        }

        const changeMarker = document.getElementById(`change_${empId}`);
        if (changeMarker) {
            changeMarker.style.display = isChanged ? 'inline-block' : 'none';
        }
    });

    const topCount = document.getElementById('topPendingCount');
    if (topCount) topCount.textContent = count;

    const botInfo = document.getElementById('bottomPendingInfo');
    if (botInfo) {
        botInfo.textContent = `${count} unsaved changes`;
        botInfo.style.display = count > 0 ? 'inline-block' : 'none';
    }
}

// ============================================================
// CORE STATUS SETTER
// ============================================================
function setEmpStatus(empId, targetStatus, allowToggle = false) {
    const input = document.getElementById(`statusInput_${empId}`);
    if (!input) return;

    let newStatus = targetStatus;
    if (allowToggle && input.value === targetStatus) {
        newStatus = '';
    }

    input.value = newStatus;

    // 1. Update segmented buttons across table & card views
    document.querySelectorAll(`[data-seg-emp="${empId}"]`).forEach(segGroup => {
        segGroup.querySelectorAll('.seg-btn').forEach(btn => {
            const btnVal = btn.textContent.trim();
            const mappedVal = {
                'P': 'present',
                'A': 'absent',
                'NW': 'no_work',
                'SL': 'leave',
                'SH': 'sent_home',
                'RD': 'rest_day'
            }[btnVal] || '';

            btn.classList.toggle('active', mappedVal === newStatus);
        });
    });

    // 2. Update master item elements data attribute
    document.querySelectorAll(`[data-emp-id="${empId}"]`).forEach(el => {
        el.setAttribute('data-emp-status', newStatus);
    });

    // 3. Update Table Row classes & tag
    const row = document.getElementById(`emp_row_${empId}`);
    if (row) {
        row.className = row.className.replace(/\bst-row-\w+/g, '');
        row.classList.add(newStatus ? `st-row-${newStatus}` : 'st-row-unrecorded');
    }
    const tag = document.getElementById(`tag_${empId}`);
    if (tag) {
        tag.textContent = newStatus ? newStatus.toUpperCase() : 'UNRECORDED';
    }

    // 4. Update Card classes & card tag
    const card = document.getElementById(`card_${empId}`);
    if (card) {
        card.className = card.className.replace(/\bst-card-\w+/g, '');
        card.classList.add(newStatus ? `st-card-${newStatus}` : 'st-card-unrecorded');
    }
    const cardTag = document.getElementById(`card_tag_${empId}`);
    if (cardTag) {
        cardTag.textContent = newStatus ? newStatus.toUpperCase() : 'UNRECORDED';
    }
}

// Handler for manual single-button clicks (allows toggle off)
function handleStatusClick(empId, targetStatus) {
    setEmpStatus(empId, targetStatus, true);
    updateLiveCounters();
    updatePendingCount();
}


// ============================================================
// BATCH ACTIONS & SELECTION DOCK (DEDUPLICATED)
// ============================================================
function toggleDeptCheckboxes(deptId, isChecked) {
    document.querySelectorAll(`.mass-emp-checkbox[data-dept-id="${deptId}"]`).forEach(cb => {
        cb.checked = isChecked;
    });
    updateBatchDock();
}

function updateBatchDock() {
    const checkedBoxes = document.querySelectorAll('.mass-emp-checkbox:checked');
    // Deduplicate by value (empId) in case checkboxes exist in both views
    const uniqueIds = new Set();
    checkedBoxes.forEach(cb => uniqueIds.add(cb.value));

    const dock = document.getElementById('massBatchDock');
    const countSpan = document.getElementById('massSelectedCount');
    
    if (uniqueIds.size > 0) {
        dock.style.display = 'block';
        countSpan.textContent = uniqueIds.size;
    } else {
        dock.style.display = 'none';
    }
}

function clearBatchSelection() {
    document.querySelectorAll('.mass-emp-checkbox').forEach(cb => cb.checked = false);
    document.querySelectorAll('.dept-select-all').forEach(cb => cb.checked = false);
    updateBatchDock();
}

function applyBatchStatus(status) {
    const checkedBoxes = document.querySelectorAll('.mass-emp-checkbox:checked');
    const processed = new Set();
    checkedBoxes.forEach(cb => {
        const empId = parseInt(cb.value);
        if (empId && !processed.has(empId)) {
            processed.add(empId);
            setEmpStatus(empId, status, false);
        }
    });
    clearBatchSelection();
    updateLiveCounters();
    updatePendingCount();
}

// Mark all employees in a department (Smart toggle: if all already match, uncheck/clear all)
function markAllDept(deptId, status) {
    const deptEmpIds = [];
    const seen = new Set();
    document.querySelectorAll(`[data-emp-dept="${deptId}"]`).forEach(item => {
        const empId = item.getAttribute('data-emp-id');
        if (empId && !seen.has(empId)) {
            seen.add(empId);
            deptEmpIds.push(empId);
        }
    });

    if (deptEmpIds.length === 0) return;

    // Check if all employees in department already have this status
    const allAlreadyMatch = deptEmpIds.every(empId => {
        const input = document.getElementById(`statusInput_${empId}`);
        return input && input.value === status;
    });

    // If all are already this status, uncheck/clear them all; otherwise set to status
    const targetStatus = allAlreadyMatch ? '' : status;

    deptEmpIds.forEach(empId => {
        setEmpStatus(empId, targetStatus, false);
    });

    updateLiveCounters();
    updatePendingCount();
}

// Mark all currently visible employees (Smart toggle: if all already match, uncheck/clear all)
function markAllVisible(status) {
    const visibleEmpIds = [];
    const seen = new Set();
    document.querySelectorAll('.emp-master-item').forEach(item => {
        if (item.style.display !== 'none') {
            const empId = item.getAttribute('data-emp-id');
            if (empId && !seen.has(empId)) {
                seen.add(empId);
                visibleEmpIds.push(empId);
            }
        }
    });

    if (visibleEmpIds.length === 0) return;

    // Check if all visible employees already have this status
    const allAlreadyMatch = visibleEmpIds.every(empId => {
        const input = document.getElementById(`statusInput_${empId}`);
        return input && input.value === status;
    });

    // If all are already this status, uncheck/clear them all; otherwise set to status
    const targetStatus = allAlreadyMatch ? '' : status;

    visibleEmpIds.forEach(empId => {
        setEmpStatus(empId, targetStatus, false);
    });

    updateLiveCounters();
    updatePendingCount();
}

// Quick filter by pill click
function quickFilterStatus(status) {
    const select = document.getElementById('filterStatusSelect');
    if (select) {
        select.value = status;
        applySortingAndFiltering();
    }
}

// ============================================================
// LIVE COUNTERS & PROGRESS
// ============================================================
function updateLiveCounters() {
    let p = 0, a = 0, nw = 0, sl = 0, sh = 0, rd = 0, un = 0;
    const deptTotals = {};
    const deptMarked = {};

    document.querySelectorAll('[data-status-input]').forEach(input => {
        const val = input.value;
        const empId = input.getAttribute('data-status-input');
        const empItem = document.querySelector(`[data-emp-id="${empId}"]`);
        const deptId = empItem ? empItem.getAttribute('data-emp-dept') : null;

        if (deptId) {
            deptTotals[deptId] = (deptTotals[deptId] || 0) + 1;
            if (val) deptMarked[deptId] = (deptMarked[deptId] || 0) + 1;
        }

        if (!val) un++;
        else if (val === 'present') p++;
        else if (val === 'absent') a++;
        else if (val === 'no_work') nw++;
        else if (val === 'leave' || val === 'on_leave') sl++;
        else if (val === 'sent_home') sh++;
        else if (val === 'rest_day') rd++;
    });

    const elP = document.getElementById('stat_p'); if (elP) elP.textContent = p;
    const elA = document.getElementById('stat_a'); if (elA) elA.textContent = a;
    const elNW = document.getElementById('stat_nw'); if (elNW) elNW.textContent = nw;
    const elSL = document.getElementById('stat_sl'); if (elSL) elSL.textContent = sl;
    const elSH = document.getElementById('stat_sh'); if (elSH) elSH.textContent = sh;
    const elRD = document.getElementById('stat_rd'); if (elRD) elRD.textContent = rd;
    const elUN = document.getElementById('stat_un'); if (elUN) elUN.textContent = un;

    Object.keys(deptTotals).forEach(dId => {
        const el = document.getElementById(`dept_marked_count_${dId}`);
        if (el) {
            el.textContent = `${deptMarked[dId] || 0}`;
        }
    });
}

// ============================================================
// SEARCH, SORT & FILTER ENGINE
// ============================================================
function applySortingAndFiltering() {
    const query = (document.getElementById('employeeSearchInput')?.value || '').toLowerCase().trim();
    const statusFilter = document.getElementById('filterStatusSelect')?.value || 'all';
    const sortBy = document.getElementById('sortBySelect')?.value || 'dept';

    let totalVisible = 0;
    const deptMatches = {};

    document.querySelectorAll('.emp-master-item').forEach(item => {
        const name = (item.getAttribute('data-emp-name') || '').toLowerCase();
        const pos = (item.getAttribute('data-emp-pos') || '').toLowerCase();
        const dId = item.getAttribute('data-emp-dept');
        const status = item.getAttribute('data-emp-status') || '';

        const matchesQuery = query === '' || name.includes(query) || pos.includes(query);
        let matchesStatus = true;
        if (statusFilter === 'unrecorded') {
            matchesStatus = !status;
        } else if (statusFilter !== 'all') {
            matchesStatus = (status === statusFilter) || (statusFilter === 'leave' && status === 'on_leave');
        }

        const isVisible = matchesQuery && matchesStatus;
        item.style.display = isVisible ? '' : 'none';

        if (isVisible) {
            totalVisible++;
            deptMatches[dId] = (deptMatches[dId] || 0) + 1;
        }
    });

    // Update Department cards visibility
    document.querySelectorAll('[data-forum-dept]').forEach(card => {
        const dId = card.getAttribute('data-forum-dept');
        const hasMatches = !!(deptMatches[dId] && deptMatches[dId] > 0);
        card.style.display = hasMatches ? '' : 'none';

        // Auto unfold if search query active
        if (query !== '' && hasMatches) {
            const body = document.getElementById(`dept_body_${dId}`);
            const icon = document.getElementById(`dept_fold_icon_${dId}`);
            const tag = document.getElementById(`dept_folded_tag_${dId}`);
            if (body && body.style.display === 'none') {
                body.style.display = '';
                if (icon) icon.textContent = '▼';
                if (card) card.classList.remove('is-folded');
                if (tag) tag.style.display = 'none';
            }
        }
    });

    const notice = document.getElementById('noMatchesNotice');
    if (notice) {
        notice.style.display = totalVisible === 0 ? 'block' : 'none';
    }
}

// Modal Helpers
function closeModal(id) {
    const m = document.getElementById(id);
    if (m) m.style.display = 'none';
}
function openAddDeptModal() {
    const m = document.getElementById('addDeptModal');
    if (m) {
        document.getElementById('new_dept_name').value = '';
        m.style.display = 'flex';
        document.getElementById('new_dept_name').focus();
    }
}
function openEditEmpModal(id, first, last, pos, deptId) {
    const m = document.getElementById('editEmpModal');
    if (m) {
        document.getElementById('edit_emp_id').value = id;
        document.getElementById('edit_emp_first').value = first;
        document.getElementById('edit_emp_last').value = last;
        document.getElementById('edit_emp_pos').value = pos || 'WAREHOUSE WORKER';
        document.getElementById('edit_emp_dept').value = deptId || '';
        m.style.display = 'flex';
    }
}

// AJAX actions for modals
async function submitAddDeptAjax() {
    const nameInput = document.getElementById('new_dept_name');
    const name = nameInput.value.trim();
    if (!name) return alert('Department name is required.');

    try {
        const res = await fetch('/api/departments', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': '<%= csrfToken %>' },
            body: JSON.stringify({ name })
        });
        const data = await res.json();
        if (data.success) {
            closeModal('addDeptModal');
            location.reload();
        } else {
            alert(data.error || 'Failed to create department.');
        }
    } catch (e) {
        alert('Error communicating with server.');
    }
}

async function submitEditEmpAjax() {
    const id = document.getElementById('edit_emp_id').value;
    const first = document.getElementById('edit_emp_first').value.trim();
    const last = document.getElementById('edit_emp_last').value.trim();
    const pos = document.getElementById('edit_emp_pos').value.trim();
    const deptId = document.getElementById('edit_emp_dept').value;

    if (!first || !last) return alert('First and Last name are required.');

    try {
        const res = await fetch(`/api/employees/${id}`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': '<%= csrfToken %>' },
            body: JSON.stringify({
                first_name: first,
                last_name: last,
                position: pos,
                department_id: deptId ? parseInt(deptId) : null
            })
        });
        const data = await res.json();
        if (data.success) {
            closeModal('editEmpModal');
            location.reload();
        } else {
            alert(data.error || 'Failed to update employee.');
        }
    } catch (e) {
        alert('Error communicating with server.');
    }
}
</script>


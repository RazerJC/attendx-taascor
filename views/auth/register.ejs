<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - TAASCOR</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="auth-page">
    <div class="auth-card" style="max-width: 480px;">
        <div class="auth-header">
            <div class="auth-logo-badge">
                <img src="/images/taascor-logo.png" alt="TAASCOR Logo">
            </div>
            <h1>Attendance Monitoring System</h1>
            <p>Coordinator Registration</p>
        </div>

        <div class="auth-body">
            <h2>Create Coordinator Account</h2>
            <p style="font-size: 0.82rem; color: var(--color-gray-500); margin-bottom: 20px; text-align: center;">
                Requires an authorized company email ending in <strong>@taascor.com</strong>.
            </p>

            <% if (typeof flash !== 'undefined') { %>
                <% if (flash.error) { %>
                    <div class="alert alert-error"><%= flash.error %></div>
                <% } %>
            <% } %>

            <form action="/register" method="POST">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                <div class="form-group">
                    <label for="full_name">Full Name <span class="required">*</span></label>
                    <input type="text" id="full_name" name="full_name" class="form-control" placeholder="e.g. Juan Dela Cruz" required autofocus>
                </div>

                <div class="form-group">
                    <label for="email">Company Email Address <span class="required">*</span></label>
                    <input type="email" id="email" name="email" class="form-control" placeholder="firstname.lastname@taascor.com" required>
                    <div class="form-help">Must end with @taascor.com. A verification link will be sent.</div>
                </div>

                <div class="form-group">
                    <label for="password">System Password <span class="required">*</span></label>
                    <input type="password" id="password" name="password" class="form-control" placeholder="At least 8 characters" required minlength="8">
                    <div class="form-help">Do NOT enter your Hostinger mailbox password. Create a unique system password.</div>
                </div>

                <div class="form-group">
                    <label for="confirm_password">Confirm Password <span class="required">*</span></label>
                    <input type="password" id="confirm_password" name="confirm_password" class="form-control" placeholder="Re-enter password" required minlength="8">
                </div>

                <div style="background: var(--color-info-bg); border-left: 3px solid var(--color-info); padding: 10px 14px; border-radius: 4px; font-size: 0.78rem; color: #1E40AF; margin-bottom: 20px;">
                    <strong>Note:</strong> All new registrations are created as <em>COORDINATOR</em> accounts in <em>Pending</em> status. HR must approve and assign your warehouse/area before system access is granted.
                </div>

                <button type="submit" class="btn btn-primary btn-block btn-lg">
                    Register Coordinator Account
                </button>
            </form>
        </div>

        <div class="auth-footer">
            <span>Already have an approved account?</span>
            <a href="/login" style="margin-left: 6px;">Sign In</a>
        </div>
    </div>
</body>
</html>

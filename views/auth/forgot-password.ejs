<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - TAASCOR</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="auth-page">
    <div class="auth-card">
        <div class="auth-header">
            <div class="auth-logo-badge">
                <img src="/images/taascor-logo.png" alt="TAASCOR Logo">
            </div>
            <h1>Password Recovery</h1>
            <p>TAASCOR Management & General Services Corp.</p>
        </div>

        <div class="auth-body">
            <h2>Forgot Your Password?</h2>
            <p style="font-size: 0.85rem; color: var(--color-gray-600); margin-bottom: 20px; text-align: center;">
                Enter your company email and we will send you instructions to reset your password.
            </p>

            <% if (typeof flash !== 'undefined' && flash.error) { %>
                <div class="alert alert-error"><%= flash.error %></div>
            <% } %>

            <form action="/forgot-password" method="POST">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                <div class="form-group">
                    <label for="email">Company Email <span class="required">*</span></label>
                    <input type="email" id="email" name="email" class="form-control" placeholder="user@taascor.com" required autofocus>
                </div>

                <button type="submit" class="btn btn-primary btn-block btn-lg" style="margin-top: 20px;">
                    Send Reset Link
                </button>
            </form>
        </div>

        <div class="auth-footer">
            <a href="/login">Return to Sign In</a>
        </div>
    </div>
</body>
</html>

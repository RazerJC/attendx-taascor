<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - TAASCOR</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="auth-page">
    <div class="auth-card">
        <div class="auth-header">
            <div class="auth-logo-badge">
                <img src="/images/taascor-logo.png" alt="TAASCOR Logo">
            </div>
            <h1>Attendance Monitoring System</h1>
            <p>TAASCOR Management & General Services Corp.</p>
        </div>

        <div class="auth-body">
            <h2>Sign In to Your Account</h2>

            <!-- Flash messages -->
            <% if (typeof flash !== 'undefined') { %>
                <% if (flash.success) { %>
                    <div class="alert alert-success"><%= flash.success %></div>
                <% } %>
                <% if (flash.error) { %>
                    <div class="alert alert-error"><%= flash.error %></div>
                <% } %>
                <% if (flash.warning) { %>
                    <div class="alert alert-warning"><%= flash.warning %></div>
                <% } %>
            <% } %>

            <% if (typeof suspended !== 'undefined' && suspended) { %>
                <div class="alert alert-error">Your session ended because this account has been suspended or deactivated.</div>
            <% } %>

            <form action="/login" method="POST">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                <div class="form-group">
                    <label for="email">Company Email Address <span class="required">*</span></label>
                    <input type="email" id="email" name="email" class="form-control" placeholder="user@taascor.com" required autofocus>
                </div>

                <div class="form-group">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                        <label for="password" style="margin-bottom: 0;">Password <span class="required">*</span></label>
                        <a href="/forgot-password" style="font-size: 0.78rem; color: var(--color-primary);">Forgot password?</a>
                    </div>
                    <input type="password" id="password" name="password" class="form-control" placeholder="••••••••" required>
                </div>

                <button type="submit" class="btn btn-primary btn-block btn-lg" style="margin-top: 24px;">
                    Sign In
                </button>
            </form>
        </div>

        <div class="auth-footer">
            <span>New Coordinator?</span>
            <a href="/register" style="margin-left: 6px;">Register with @taascor.com</a>
        </div>
    </div>
</body>
</html>

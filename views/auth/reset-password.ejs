<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - TAASCOR</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="auth-page">
    <div class="auth-card">
        <div class="auth-header">
            <div class="auth-logo-badge">
                <img src="/images/taascor-logo.png" alt="TAASCOR Logo">
            </div>
            <h1>Set New Password</h1>
            <p>TAASCOR Management & General Services Corp.</p>
        </div>

        <div class="auth-body">
            <h2>Create New Password</h2>

            <% if (typeof flash !== 'undefined' && flash.error) { %>
                <div class="alert alert-error"><%= flash.error %></div>
            <% } %>

            <form action="/reset-password" method="POST">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="token" value="<%= token %>">

                <div class="form-group">
                    <label for="password">New Password <span class="required">*</span></label>
                    <input type="password" id="password" name="password" class="form-control" required minlength="8">
                </div>

                <div class="form-group">
                    <label for="confirm_password">Confirm New Password <span class="required">*</span></label>
                    <input type="password" id="confirm_password" name="confirm_password" class="form-control" required minlength="8">
                </div>

                <button type="submit" class="btn btn-primary btn-block btn-lg" style="margin-top: 20px;">
                    Update Password
                </button>
            </form>
        </div>
    </div>
</body>
</html>

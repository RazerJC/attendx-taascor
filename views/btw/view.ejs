<%- include('../partials/layout-top') %>

<div class="page-header">
    <div>
        <h2><%= btwCase.case_ref %> — Back-to-Work Clearance</h2>
        <div class="breadcrumb">
            <a href="/btw">Requests & Concerns</a>
            <span>/</span>
            <span>Back-to-Work</span>
            <span>/</span>
            <span><%= btwCase.case_ref %></span>
        </div>
    </div>
    <div>
        <button class="btn btn-outline" type="button" data-employee-status="<%= btwCase.employee_id %>"><%= btwCase.status === 'not_approved' ? 'Rejected' : btwCase.status.replace(/_/g, ' ') %> · View employee status</button>
    </div>
</div>

<!-- Highlighted Official Decision Box -->
<% if (btwCase.effective_action_type === 'suspension') { %>
    <div class="decision-box <%= btwCase.status === 'not_approved' ? 'rejected' : '' %>" style="border-left: 5px solid #dc2626; background: #fff5f5; padding: 20px; border-radius: 8px; margin-bottom: 20px; border: 1px solid #fecaca;">
        <h4 style="color: #dc2626; display: flex; align-items: center; gap: 8px; margin-top: 0; font-size: 1.15rem;">
            🔴 Official HR Decision: <%= btwCase.status === 'approved' ? 'APPROVED WITH SUSPENSION' : 'NOT APPROVED (SUSPENDED)' %>
        </h4>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 12px; margin-top: 14px; background: #ffffff; padding: 14px; border-radius: 6px; border: 1px solid #fed7d7;">
            <div>
                <span class="text-xs text-muted" style="text-transform: uppercase; font-weight: 700; display: block;">Status</span>
                <span class="badge badge-danger" style="font-weight: 800; margin-top: 4px; display: inline-block;">SUSPENDED</span>
            </div>
            <div>
                <span class="text-xs text-muted" style="text-transform: uppercase; font-weight: 700; display: block;">Nilabag na Article</span>
                <div style="font-weight: 700; color: #991b1b; margin-top: 4px; font-size: 0.9rem;">
                    <%= btwCase.effective_article || 'Company Policy Code of Conduct' %>
                </div>
            </div>
            <div>
                <span class="text-xs text-muted" style="text-transform: uppercase; font-weight: 700; display: block;">Simula ng Suspension</span>
                <div style="font-weight: 700; color: #dc2626; margin-top: 4px; font-size: 0.95rem;">
                    <%= formatDate(btwCase.effective_suspension_start) %>
                </div>
            </div>
            <div>
                <span class="text-xs text-muted" style="text-transform: uppercase; font-weight: 700; display: block;">Huling Araw ng Suspension</span>
                <div style="font-weight: 700; color: #b91c1c; margin-top: 4px; font-size: 0.95rem;">
                    <%= formatDate(btwCase.effective_suspension_end) %>
                </div>
            </div>
            <div>
                <span class="text-xs text-muted" style="text-transform: uppercase; font-weight: 700; display: block;">Petsa ng Balik Trabaho</span>
                <div style="font-weight: 800; color: #166534; font-size: 1.05rem; margin-top: 4px;">
                    <%= formatDate(btwCase.effective_return_date) %>
                </div>
            </div>
        </div>
        <div style="margin-top: 12px; font-size: 0.95rem;">
            <strong>Dahilan / Remarks:</strong> <%= btwCase.effective_hr_remarks || '—' %>
        </div>
        <div class="text-xs text-muted" style="margin-top: 8px;">
            Reviewer: <strong><%= btwCase.hr_reviewer_name || 'HR Department' %></strong> • Decided: <%= formatDateTime(btwCase.decision_at) %>
        </div>
    </div>
<% } else if (btwCase.status === 'approved') { %>
    <div class="decision-box" style="border-left: 5px solid var(--color-success); background: #f0fdf4; padding: 20px; border-radius: 8px; margin-bottom: 20px; border: 1px solid #bbf7d0;">
        <h4 style="color: var(--color-success); margin-top: 0; font-size: 1.15rem;">✓ Official HR Clearance Decision: APPROVED (CLEARED)</h4>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 12px; margin-top: 14px; background: #ffffff; padding: 14px; border-radius: 6px; border: 1px solid #dcfce7;">
            <div>
                <span class="text-xs text-muted" style="text-transform: uppercase; font-weight: 700; display: block;">Status</span>
                <span class="badge badge-success" style="font-weight: 700; margin-top: 4px; display: inline-block;">CLEARED / NOT SUSPENDED</span>
            </div>
            <% if (btwCase.effective_article) { %>
                <div>
                    <span class="text-xs text-muted" style="text-transform: uppercase; font-weight: 700; display: block;">Article / Policy</span>
                    <div style="font-weight: 600; color: #1e293b; margin-top: 4px;"><%= btwCase.effective_article %></div>
                </div>
            <% } %>
            <div>
                <span class="text-xs text-muted" style="text-transform: uppercase; font-weight: 700; display: block;">Petsa ng Balik Trabaho</span>
                <div style="font-size: 1.1rem; color: var(--color-success); font-weight: 800; margin-top: 4px;"><%= formatDate(btwCase.effective_return_date) %></div>
            </div>
        </div>
        <div style="margin-top: 12px; font-size: 0.95rem;">
            <strong>Dahilan / Remarks:</strong> <%= btwCase.effective_hr_remarks || 'Clearance approved for resumption of duties.' %>
        </div>
        <div class="text-xs text-muted" style="margin-top: 8px;">
            Reviewer: <strong><%= btwCase.hr_reviewer_name || 'HR Department' %></strong> • Decided: <%= formatDateTime(btwCase.decision_at) %>
        </div>
    </div>
<% } else if (btwCase.status === 'not_approved') { %>
    <div class="decision-box rejected" style="border-left: 5px solid var(--color-danger); background: #fef2f2; padding: 20px; border-radius: 8px; margin-bottom: 20px; border: 1px solid #fecaca;">
        <h4 style="color: var(--color-danger); margin-top: 0; font-size: 1.15rem;">✕ Official HR Clearance Decision: NOT APPROVED</h4>
        <% if (btwCase.effective_article) { %>
            <p><strong>Nilabag na Article:</strong> <span style="font-weight: 700; color: #991b1b;"><%= btwCase.effective_article %></span></p>
        <% } %>
        <p><strong>Reviewer:</strong> <%= btwCase.hr_reviewer_name || 'HR Department' %> • <strong>Decided:</strong> <%= formatDateTime(btwCase.decision_at) %></p>
        <% if (btwCase.effective_hr_remarks) { %>
            <p><strong>Dahilan / Official Remarks:</strong> <%= btwCase.effective_hr_remarks %></p>
        <% } %>
    </div>
<% } else if (btwCase.status === 'for_clarification') { %>
    <div class="alert alert-warning" style="margin-bottom: 20px;">
        <span class="alert-icon">⚠️</span>
        <div>
            <strong>Clarification Requested by HR:</strong> Please review the HR comments in the thread below and provide additional explanation.
        </div>
    </div>
<% } else { %>
    <div class="alert alert-info" style="margin-bottom: 20px;">
        <span class="alert-icon">ℹ️</span>
        <div>
            <strong>Pending HR Review:</strong> This clearance case is currently awaiting review and decision by the HR department.
        </div>
    </div>
<% } %>

<!-- Case Summary Grid -->
<div class="detail-grid card mb-3" style="padding: 20px;">
    <div class="detail-item">
        <div class="detail-label">Employee</div>
        <div class="detail-value">
            <a href="/employees/<%= btwCase.employee_id %>"><%= btwCase.employee_name %> (<%= btwCase.emp_code %>)</a>
        </div>
    </div>
    <div class="detail-item">
        <div class="detail-label">Position / Warehouse</div>
        <div class="detail-value"><%= btwCase.position_title || 'Worker' %> • <%= btwCase.area_name %></div>
    </div>
    <div class="detail-item">
        <div class="detail-label">Assigned Coordinator</div>
        <div class="detail-value"><%= btwCase.coordinator_name || '—' %></div>
    </div>
    <div class="detail-item">
        <div class="detail-label">Related Absence Date(s)</div>
        <div class="detail-value">
            <% dates.forEach(d => { %>
                <span class="badge badge-danger" style="margin-right: 4px;"><%= formatDate(d) %></span>
            <% }) %>
        </div>
    </div>
    <div class="detail-item">
        <div class="detail-label">Initial Absence Reason</div>
        <div class="detail-value"><%= btwCase.absence_reason || 'Unexcused Absence' %></div>
    </div>
    <div class="detail-item">
        <div class="detail-label">Case Created</div>
        <div class="detail-value"><%= formatDateTime(btwCase.created_at) %></div>
    </div>
</div>

<!-- Authorized Decision Actions for HR / ADMIN -->
<% if (user.role === 'HR' || user.role === 'ADMIN') { %>
    <div class="card mb-3" style="border: 2px solid var(--color-primary, #1e3a8a); box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1);">
        <div class="card-header" style="background: rgba(30, 58, 138, 0.06); padding: 14px 20px;">
            <h3 style="margin: 0; color: var(--color-primary, #1e3a8a);">⚖️ Official HR Clearance & Disciplinary Decision</h3>
            <span class="text-sm text-muted">Authorized for HR and Administrator roles only</span>
        </div>
        <div class="card-body" style="padding: 20px;">
            <form action="/btw/<%= btwCase.id %>/decision" method="POST">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                <div class="form-row">
                    <div class="form-group" style="flex: 1;">
                        <label for="decision">Clearance Decision <span class="required">*</span></label>
                        <select id="decision" name="decision" class="form-control" onchange="toggleReturnDate(this.value)" required>
                            <option value="">— Select Decision —</option>
                            <option value="approved" <%= btwCase.status === 'approved' ? 'selected' : '' %>>Approve Clearance (May Balik Trabaho)</option>
                            <option value="for_clarification" <%= btwCase.status === 'for_clarification' ? 'selected' : '' %>>Request Clarification (Humingi ng Paliwanag)</option>
                            <option value="not_approved" <%= btwCase.status === 'not_approved' ? 'selected' : '' %>>Do Not Approve (Tanggihan)</option>
                        </select>
                    </div>

                    <div class="form-group" id="returnDateGroup" style="flex: 1;">
                        <label for="authorized_return_date">Petsa ng Balik Trabaho (Authorized Return Date) <span class="required">*</span></label>
                        <input type="date" id="authorized_return_date" name="authorized_return_date" class="form-control" 
                               value="<%= btwCase.effective_return_date || btwCase.authorized_return_date || '' %>">
                        <div class="form-help">Mandatory when clearance is approved.</div>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group" style="flex: 1;">
                        <label for="action_type">Aksyon / Suspended Ba?</label>
                        <select class="form-control" id="action_type" name="action_type">
                            <option value="none" <%= (!btwCase.effective_action_type || btwCase.effective_action_type === 'none') ? 'selected' : '' %>>Walang Suspension (Cleared / No Action)</option>
                            <option value="suspension" <%= btwCase.effective_action_type === 'suspension' ? 'selected' : '' %>>🔴 Suspension (I-suspend ang Empleyado)</option>
                            <option value="nte" <%= btwCase.effective_action_type === 'nte' ? 'selected' : '' %>>📄 NTE Issued (Notice to Explain)</option>
                            <option value="warning" <%= btwCase.effective_action_type === 'warning' ? 'selected' : '' %>>⚠️ Written Warning Issued</option>
                            <option value="violation" <%= btwCase.effective_action_type === 'violation' ? 'selected' : '' %>>📋 Policy Violation Recorded</option>
                        </select>
                    </div>
                    <div class="form-group" style="flex: 1;">
                        <label for="issued_date">Petsa ng Paglabas ng Aksyon (Issue Date)</label>
                        <input class="form-control" type="date" id="issued_date" name="issued_date">
                    </div>
                </div>

                <!-- Nilabag na Article (Article Violated) -->
                <div class="form-group">
                    <label for="article_violated">Nilabag na Article / Company Rule Violated</label>
                    <input type="text" id="article_violated" name="article_violated" list="articles_list" class="form-control" 
                           placeholder="Pumili o mag-type ng nilabag na article (e.g., Article IV, Section 1 - AWOL)" 
                           value="<%= btwCase.effective_article || '' %>">
                    <datalist id="articles_list">
                        <option value="Article IV, Section 1 - Habitual Absenteeism / AWOL"></option>
                        <option value="Article IV, Section 2 - Habitual Tardiness / Undertime"></option>
                        <option value="Article V, Section 1 - Insubordination / Failure to Follow Instructions"></option>
                        <option value="Article VI, Section 2 - Serious Misconduct / Safety Violations"></option>
                        <option value="Article VII, Section 1 - Abandonment of Post / Unauthorized Leave"></option>
                        <option value="Article VIII, Section 3 - Dishonesty / Fraudulent Attendance Record"></option>
                    </datalist>
                    <div class="form-help">Ilagay ang partikular na artikulo o panuntunan ng kumpanya na nilabag ng empleyado.</div>
                </div>

                <!-- Suspension Date Fields -->
                <div class="form-row" id="suspension-fields" style="<%= (btwCase.effective_action_type === 'suspension') ? '' : 'display: none;' %>">
                    <div class="form-group" style="flex: 1;">
                        <label for="suspension_start">Petsa ng Simula ng Suspension <span class="required">*</span></label>
                        <input class="form-control" type="date" id="suspension_start" name="suspension_start" 
                               value="<%= btwCase.effective_suspension_start || '' %>">
                    </div>
                    <div class="form-group" style="flex: 1;">
                        <label for="suspension_end">Petsa ng Tapos / Huling Araw ng Suspension <span class="required">*</span></label>
                        <input class="form-control" type="date" id="suspension_end" name="suspension_end" 
                               value="<%= btwCase.effective_suspension_end || '' %>">
                    </div>
                </div>

                <div class="form-group">
                    <label for="hr_remarks">Anong Dahilan / HR Findings & Remarks <span class="required">*</span></label>
                    <textarea id="hr_remarks" name="hr_remarks" required class="form-control" rows="3" 
                              placeholder="Ibigay ang kumpletong dahilan, kondisyon ng balik trabaho, o mga basehan ng desisyon..."><%= btwCase.effective_hr_remarks || btwCase.hr_remarks || '' %></textarea>
                </div>

                <button type="submit" class="btn btn-primary" style="font-weight: 700; padding: 10px 22px;">
                    ⚖️ Record Official Decision
                </button>
            </form>
        </div>
    </div>

    <script>
    function toggleReturnDate(val) {
        const group = document.getElementById('returnDateGroup');
        const input = document.getElementById('authorized_return_date');
        if (val === 'approved') {
            group.style.display = 'block';
            input.setAttribute('required', 'required');
        } else {
            input.removeAttribute('required');
        }
    }
    toggleReturnDate(document.getElementById('decision').value);

    document.getElementById('action_type').addEventListener('change', function () {
        const isSuspension = this.value === 'suspension';
        const suspFields = document.getElementById('suspension-fields');
        suspFields.style.display = isSuspension ? 'flex' : 'none';
        document.getElementById('issued_date').required = this.value !== 'none';
        document.getElementById('suspension_start').required = isSuspension;
        document.getElementById('suspension_end').required = isSuspension;
    });
    </script>
<% } %>

<!-- Forum Thread Messages -->
<div class="card mb-3">
    <div class="card-header">
        <h3>💬 Case Thread & Communication Timeline (<%= entries.length %>)</h3>
    </div>
    <div class="card-body">
        <div class="thread">
            <% entries.forEach(entry => { %>
                <div class="thread-entry">
                    <div class="thread-avatar <%= entry.author_role.toLowerCase() %>">
                        <%= entry.author_name ? entry.author_name.charAt(0).toUpperCase() : 'S' %>
                    </div>
                    <div class="thread-content">
                        <div class="thread-meta">
                            <span class="thread-author"><%= entry.author_name || 'System' %></span>
                            <span class="thread-role <%= entry.author_role.toLowerCase() %>"><%= entry.author_role %></span>
                            <span class="thread-time">• <%= formatDateTime(entry.created_at) %></span>
                        </div>
                        <div class="thread-body <%= entry.entry_type === 'status_change' ? 'thread-status-change' : '' %>"><%= entry.content %></div>
                    </div>
                </div>
            <% }) %>
        </div>

        <!-- Add Reply Form -->
        <div style="border-top: 2px solid var(--color-gray-200); padding-top: 20px; margin-top: 20px;">
            <h4 style="font-size: 0.95rem; margin-bottom: 12px; color: var(--color-primary);">Post Update or Follow-Up Remarks</h4>
            <form action="/btw/<%= btwCase.id %>/reply" method="POST">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                <div class="form-group">
                    <textarea name="content" class="form-control" rows="3" placeholder="<%= user.role === 'COORDINATOR' ? 'Provide explanation, attach employee statements, or report follow-up...' : 'Add HR instructions, remarks, or notes...' %>" required></textarea>
                </div>

                <button type="submit" class="btn btn-outline">
                    Post Message
                </button>
            </form>
        </div>
    </div>
</div>

<%- include('../partials/layout-bottom') %>

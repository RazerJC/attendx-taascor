# Uploads Directory Security — TAASCOR AttendX
# Completely prevent execution of any scripts in the uploads directory

# Disable script execution
Options -ExecCGI -Indexes
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phps .cgi .pl .py .asp .sh

# Block all executable file types
<FilesMatch "\.(php|phtml|php3|php4|php5|php7|php8|phps|cgi|pl|py|sh|bash|exe|bat|cmd|com|vbs|js|jar|phar)$">
    Require all denied
</FilesMatch>

# Only allow safe file types (images, documents, spreadsheets)
<FilesMatch "\.(xlsx|xls|csv|pdf|docx|doc|png|jpg|jpeg|gif)$">
    Require all granted
</FilesMatch>
